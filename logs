    null_tag_mask = pl.col('tags_asset').is_null()
    assets_null_tags = assets.filter(null_tag_mask).collect(engine='streaming')
    logger.debug("%s assets from assets export with null tags. Saving to log dir for s3 upload", len(assets_null_tags))
    fn = os.path.join(LOG_DIR, "null_tags.parquet")
    assets_null_tags.write_parquet(fn)
    assets = assets.filter(~null_tag_mask)

    assets, assets_with_multiple_FISMA_ID_tags, assets_with_null_fisma_tag, assets_with_invalid_fisma_id, assets_not_in_axonius = prep_tenable_assets(assets)

    vm_cols = list(TENABLE_VM_SNOW_FINDINGS_STAGING_COLS_MAPPING.keys())
    vm_cols = vm_cols + ['asset_uuid', 'plugin_xrefs', 'last_found', 'first_found', 'plugin_cpe', 'plugin_solution', 'compliance_full_id', 'compliance_benchmark_name', 'compliance_benchmark_version', 'last_seen', 'first_seen', 'reference', 'plugin_family', 'port_port', 'port_protocol']

    logger.info("Fetching latest Tenable Findings from %s", tio._url)
    tenable_df = pl.LazyFrame()
    for query in to_do:
        finding_type = query['finding_type']
        if os.path.exists((fn:=f"{finding_type}.parquet")):
            _df = pl.scan_parquet(fn, low_memory=True)
        else:
            query_method = query['query_method']
            _df = query_method(tio, query['filters'], **query['kwargs'])
            _df.sink_parquet(fn)

        # only load these columns to save mem
        to_select = [col for col in _df.collect_schema() if col in vm_cols]
        _df = _df.select(to_select)

        _df = _df.rename({"asset_uuid": "id_asset"})

        _df = _df.with_columns(pl.lit(finding_type).alias('finding_type'))
        # _df = prep_tenable_assets(_df)
        for to_prep in query['prep']:
            logger.debug("applying %s to data.", to_prep.__name__)
            _df = to_prep(_df)

        tenable_df = pl.concat([tenable_df, _df], how='diagonal')
        del _df

    # grab total findings to calculate unstable later
    total_tenable_findings = tenable_df.select(pl.col('id_asset')).collect()

    # join assets, and remove any asset data the vuln/comp export returns
    # there's too much of a discrepancy between how vuln and comp exports
    # treat asset information
    # default 'how' is inner, therefore this will necessarily filter out any findings
    # where the asset has NO tags (i.e. can't determine FISMA ID)
    tenable_df = tenable_df.join(assets, on='id_asset')
    tenable_df = tenable_df.drop(pl.col('^asset_.*$'))

    # find duplicates before we send off
    # this can happen when the same asset is scanned with multiple audit files
    # example: 
        # 'ICE_DISA_STIG_Microsoft_Windows_11_v2r3.audit_1'
        # 'ICE_DISA_STIG_Microsoft_Windows_11_v2r3.audit'
    logger.info("Removing duplicate finding_id's from Tenable Data.")
    tenable_df = tenable_df.sort(pl.col('last_observed').str.to_datetime(TENABLE_TIME_FORMAT), descending=True).unique(subset='finding_id', keep='first', maintain_order=True)
    
    # drop columns we don't need:
    to_drop = [col for col in tenable_df.collect_schema().names() if col not in TENABLE_VM_SNOW_FINDINGS_STAGING_COLS_MAPPING.keys()]
    tenable_df = tenable_df.drop(to_drop)

    # Some things need to be filtered out
    # audit file findings
    audit_mask = pl.col('plugin_name').str.contains(".audit", literal=True)
    # disa = tenable_df.filter(disa_mask)
    logger.info("Removing %s findings are audit file related", tenable_df.filter(audit_mask).select(pl.len()).collect(engine="streaming").item())
    tenable_df = tenable_df.filter(~audit_mask)

    # add logic to turn type as DB vuln based on plugin family == "databases" <- plural

    no_cis_benchmark_expr = pl.col('finding_type').str.contains("compliance") & pl.col("stig_cis_benchmark").is_null()
    no_cis_benchmark = tenable_df.filter(no_cis_benchmark_expr)
    logger.info("Removing findings that are missing stig_cis_benchmark")
    tenable_df = tenable_df.filter(~no_cis_benchmark_expr)

    no_finding_type_expr = pl.col('finding_type').is_null()
    no_finding_type = tenable_df.filter(no_finding_type_expr)
    logger.info("Removing findings that are missing 'finding_type'")
    tenable_df = tenable_df.filter(~no_finding_type_expr)

    # we need first_discovered, and last_observed to have a proper FT 
    # to be properly grouped into a WT. if not included, need to filter out
    to_check = {
        'first_discovered': None,
        'last_observed': None
    }
    for col in to_check:
        tenable_df = tenable_df.with_columns(
            pl.when(pl.col(col).str.len_chars() == 0)
            .then(None)
            .otherwise(pl.col(col))
            .name.keep()
        )
        to_check[col] = tenable_df.filter(pl.col(col).is_null()).select(pl.len()).collect(engine="streaming").item()
        logger.info("Removing %s findings that have null value for %s", to_check[col], col)
        tenable_df = tenable_df.drop_nulls(subset=col)

    mask = pl.col('fisma_system').str.starts_with("ICE")
    # non_ICE = tenable_df.filter(~mask)
    logger.info("Dropping rows with FISMA ID not starting with 'ICE'")
    tenable_df = tenable_df.filter(mask)
    

    # Sort oldest to newest. needed to ensure date grouping is proper in WT table
    tenable_df = tenable_df.sort(by=pl.col("first_discovered").str.to_date(TENABLE_TIME_FORMAT))
    tenable_df = tenable_df.rename(TENABLE_VM_SNOW_FINDINGS_STAGING_COLS_MAPPING)

    mskb = pl.col("u_cross_references").str.contains("MSKB")   
    ssl = pl.col('u_plugin').is_in([51192, 45411, 57582, 15901, 56284, 69551, 35291])
    # if MSKB or ssl, we want to nullify the cpe data since CPE checks in the business rule could query MSKB or ssl WTs
    # that have cpe data
    tenable_df = tenable_df.with_columns(
            pl.when(mskb | ssl)
            .then(pl.lit(None))
            .otherwise(pl.col("^u_cpe.*$")).name.keep()
        )
   
    # ISVM Applicability Code
    # Takes the Tenable dataframe and filters on vuln findings where CVE exists and removes duplicate plugins
    # Result is a dataframe that is sorted by CVE listing all plugins associated

    isvm_df = get_latest_snow_table(SNOW_ISVM_TABLE_NAME, SNOW_API)
    if not isvm_df.select(pl.len()).collect(engine="streaming").item():
        pass
    else:
        tenable_cve_plugin_map_df = (
            # filter tenable_df where cve data is available, only applies to vuln data
            tenable_df.filter(pl.col('u_cve').is_not_null())
            # find unique Tenable plugins so we can have CVE's related to each plugin
            .unique(subset='u_plugin').select(pl.col('u_plugin'), pl.col('u_cve')).sort(pl.col('u_plugin'))
            # Split str cve data into a list and explode so we have 1for1 plugin/cve data
            .with_columns(pl.col('u_cve').str.split(',').alias('u_cve')).explode('u_cve')
            # agg plugins so we're left with CVEs and all Plugins that have that CVE
            .group_by(pl.col('u_cve')).agg(pl.col('u_plugin')).sort(pl.col('u_cve'))
        )

        isvm_cve_soar_map_df = (
            isvm_df
            .with_columns(
                # ISVM table CVE data is a stringyfied list, need to remove brackets
                pl.col('cve_number').str.replace(r"\[","").str.replace(r"\]","")
                # split str on comma, and strip each element of whitespace
                .str.split(',').list.eval(pl.element().str.strip_chars())
            )
            # only need these columns
            .select(['soar_isvm_id', 'cve_number'])
            # explode cve_numer to get 1to1 mapping with soar_isvm_id
            .explode('cve_number')
            # some ISVMs do not have any CVEs, filter those out
            .filter(pl.col('cve_number').str.len_chars().ne(0))
            # agg soar_isvm_id so we're left with distinct CVEs and all soar_ids that have that CVE
            .group_by(pl.col('cve_number')).agg(pl.col('soar_isvm_id').alias('u_soar_isvm_id'))
            .sort(pl.col('cve_number'))
        )

        applicable_df = (
            tenable_cve_plugin_map_df
            # join on cve which yields all plugins and soar_ids per cve
            .join(
                isvm_cve_soar_map_df, left_on="u_cve", right_on="cve_number", how='inner'
            )
            # explode so we have single plugins and associated soar_ids
            .explode('u_plugin')
            # since multiplie CVEs could tie several soar_ids to a plugin,
            # need to group plugin IDs and aggregate all ISVMs associated to that pluginc
            .group_by("u_plugin").agg(
                pl.col('u_soar_isvm_id')
                # need to explode, else we're left with a list[list[str]], we just want a list[str]
                .explode()
                # multiple CVEs could duplicate associating an ISV with a plugin, find unique
                .unique()
            )
            # convert list[str] to string since u_soar_ivsm_id in FIND table expects str
            .with_columns(pl.col("u_soar_isvm_id").list.join(","))
            .sort('u_plugin')
        )
        
        # add applicable isvm ids to tenable_df
        tenable_df = tenable_df.join(applicable_df, on="u_plugin", how='left')
        # transform map ignores null or empty strings. if we need to update and the field is empty, add a white space
        # to force it to transform
        tenable_df = tenable_df.with_columns(
            pl.when(pl.col('u_soar_isvm_id').is_null() | pl.col('u_soar_isvm_id').str.len_chars().eq(0))
            .then(pl.lit(' '))
            .otherwise(pl.col('u_soar_isvm_id'))
            .name.keep()
        )

    # prep tenable data for ingest into snow table
    tenable_df = (
        tenable_df.drop(pl.col(SNOW_LINK_DTYPE))
        .cast(pl.String)
        .with_columns(pl.all().str.slice(0,4000)) # max char length for SNOW is 4000
    )

    vm_count = tenable_df.select(pl.len()).collect(engine='streaming').item()
    logger.debug("Total VM Findings ready to POST/PATCH: %s", vm_count)
    
    start = datetime.datetime.now()

    scan_mask = pl.col('u_scan_id').is_in(latest_findings.select(pl.col('scan_id')).collect(engine="streaming")['scan_id'].implode())
    to_post = tenable_df.filter(~scan_mask).collect(engine='streaming')

    logger.info("Total of %s findings ready to be created (POST)", len(to_post))
    fn = os.path.join(LOG_DIR, "new_findings.parquet")
    if DRYRUN:
        logger.info("DryRun var set to 'True', skipping %s findings to be created (POST)", len(to_post))
    if not DRYRUN and not to_post.is_empty():
        logger.info("Sending %s findings to be created (POST)", len(to_post))
        try:
            insert_multiple(to_post, table_name=SNOW_FINDINGS_STAGING_TABLE_NAME)
            logger.info("Finished sending %s findings to POST", len(to_post))
            pass
        except BadCreds as e:
            logger.exception("%s", str(e))
            raise e

    suffix = '_fromsnow'


    logger.debug("Joining latest tenable df with latest findings df")
    # todo: need to check pl.col('state).alias('u_state'). 'state' will be from latest_findings since tenable_df
    to_patch = (
        tenable_df
        .join(
            latest_findings, 
            suffix=suffix, left_on = 'u_scan_id', right_on='scan_id', how='inner')

    ).select(*[pl.col(col) for col in tenable_df.collect_schema().names()], pl.col('state').alias('u_state')).collect(engine='streaming')

    # need to hardcode to remove first_discovered field. for reconciled sc findings, we need to persist that value
    # otherwise the patch will update that field with tvm first_discovered
    to_patch = to_patch.drop('u_first_discovered')

    total = len(to_patch)
    logger.info("%s findings to PATCH, (total pre-existing records in SNow: %s)", len(to_patch), total)

    # SNow returns reference links. we don't want to inadvertently update these, so dropping
    to_patch = to_patch.drop(pl.col(Struct({'link': String, 'value': String})))

    logger.debug("Updated states that should be revived")
    to_patch  = to_patch.with_columns(
        (
            pl.when(pl.col('u_state') != "mitigated")
            .then(pl.col('u_state'))
            .otherwise(pl.lit("revived"))
        )
    )
    revived = to_patch.filter(pl.col('u_state')=="revived")
    logger.info("%s findings have been revived", len(revived))
    logger.info("Total of %s findings ready to be updated (PATCH)", len(to_patch))

    to_patch = to_patch.drop([x for x in to_patch.collect_schema().names() if x not in import_cols])

    fn = os.path.join(LOG_DIR, "update_findings.parquet")
    if DRYRUN:
        logger.info("DryRun var set to 'True', skipping %s findings to be updated (PATCH)", len(to_patch))
    if not DRYRUN and not to_patch.is_empty():
        logger.info("Sending %s findings to be updated (PATCH)", len(to_patch))
        try:
            insert_multiple_threaded(to_patch, table_name=SNOW_FINDINGS_STAGING_TABLE_NAME)
            logger.info("Finished sending %s findings to PATCH", len(to_patch))
            pass
        except BadCreds as e:
            logger.exception("%s", str(e))
            raise e

    mitigated = latest_findings.filter(
        # if what's in SNOW is NOT in the scan_ids_from_tenable that's currenlty in Tenable
        # AND the state is NOT mitigated...then these findings have been mitigated and need to have state updated.
        ~(pl.col('scan_id').is_in(tenable_df.select('u_scan_id').collect(engine="streaming")['u_scan_id'].implode())) & ~(pl.col('state')=="mitigated")
    )

    # if scan_id has a ',', means it's from SC data. we don't want to mitigate these at this time
    mitigated = mitigated.filter(~pl.col('scan_id').str.contains(','))

    mitigated = mitigated.with_columns(
            pl.lit("mitigated").alias('state'),
        ).select(pl.col('scan_id').alias('u_scan_id'), pl.col('state').alias('u_state')).collect(engine='streaming')

    logger.info("Total of %s findings to update state to 'mitigated'", len(mitigated))
    fn = os.path.join(LOG_DIR, "mitigated_findings.parquet")
    if DRYRUN:
        logger.info("DryRun var set to 'True', skipping %s findings to update state to 'mitigated'", len(mitigated))
    if not DRYRUN and not mitigated.is_empty():
        try:
            insert_multiple_threaded(mitigated, table_name=SNOW_FINDINGS_STAGING_TABLE_NAME)
            logger.info("Finished sending %s findings to change state to 'mitigated'", len(mitigated))
            pass
        except BadCreds as e:
            logger.exception("%s", str(e))
            raise e

    logger.info("Push to SNow elapsed time %s", datetime.datetime.now() - start)

    for col, num in to_check.items():
        if num:
            unstable_logger.info('%s of Tenable VM records missing %s', num, col)

    if not (no_cis_benchmark:=no_cis_benchmark.collect(engine="streaming")).is_empty():
        unstable_logger.info(f"Missing CIS Mapping: {no_cis_benchmark['see_also'].unique().to_list()}. Update cis_mapping in {get_stig_cis_benchmark_name.__name__} function")
    if not (no_finding_type:=no_finding_type.collect(engine="streaming")).is_empty():
        unstable_logger.info(f"Missing Finding Types for {len(no_finding_type_expr)}")

    unstable_data = [
        assets_with_multiple_FISMA_ID_tags,
        assets_with_null_fisma_tag,
        assets_with_invalid_fisma_id,
        assets_not_in_axonius
    ]

    for data in unstable_data:
        if not (_assets_affected:=data.select("id_asset").unique().collect(engine="streaming")).is_empty():
            local_vars = locals().copy()
            _name = [name for name, val in local_vars.items() if val is data and name != 'data'][0]
            finds_affected = len(total_tenable_findings.filter(pl.col('id_asset').is_in(_assets_affected['id_asset'].implode())))
            unstable_logger.debug("%s TVM %s affecting %s findings", len(_assets_affected), _name, finds_affected)
        
    set_unstable(unstable_logger, unstable_fn_path)
    pass

    
if __name__ == "__main__":

    try:
        main()
    except Exception as e:
        logger.exception("Exception Occured during operation")
        raise e
