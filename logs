def get_rca(findings_df):

    rca = f"{findings_df['rca_description'].unique()[0]}"
    # asked by Core to skip poam generation for missing rca
    if not rca:
        logger.warning("RCA missing for %s, using default", findings_df['number'].unique()[0])
        rca = DEFAULT_RCA
    return  rca.upper()

