    @patch(f"{MODULE_PATH}.date")
    @patch(f"{MODULE_PATH}.logger")
    @patch(f"{MODULE_PATH}.build_fisma_all_metrics_aggregate_scores_sql")
    @patch(f"{MODULE_PATH}.rw_util.query_postgres_to_dataframe")
    @patch(f"{MODULE_PATH}.fismaScorecardUtility.load_to_db_and_perform_post_load_validation")
    @patch(f"{MODULE_PATH}.fismaScorecardUtility.archive_to_s3")
    @patch(f"{MODULE_PATH}.build_component_scores_sql")
    def test_fisma_query_returns_none_stops_workflow(
        self,
        mock_build_component_scores_sql,
        mock_archive_to_s3,
        mock_load_to_db_and_validate,
        mock_query_postgres_to_dataframe,
        mock_build_fisma_all_metrics_aggregate_scores_sql,
        mock_logger,
        mock_date,
    ):
        """Ensure workflow stops after warning when fisma query returns no data."""
        # Arrange
        engine = MagicMock(name="engine")
        bucket_name = "test-bucket"

        fixed_date = date(2026, 9, 1)
        mock_date.today.return_value = fixed_date

        sql_fisma = "SELECT * FROM fisma_agg"
        mock_build_fisma_all_metrics_aggregate_scores_sql.return_value = sql_fisma

        # First call (fisma) returns None, so workflow should return early
        mock_query_postgres_to_dataframe.return_value = None

        # Act
        run_aggregate_scores_workflow(engine=engine, bucket_name=bucket_name)

        # Assert : compute params, build and execute input query called
        mock_build_fisma_all_metrics_aggregate_scores_sql.assert_called_once()

        mock_query_postgres_to_dataframe.assert_called_once_with(
            engine=engine,
            sql_query=sql_fisma,
            params = {"etl_date": fixed_date}
        )

        mock_logger.warning.assert_called_once_with("Query returned no data")

        # Assert: No downstream processing should be invoked
        mock_load_to_db_and_validate.assert_not_called()
        mock_archive_to_s3.assert_not_called()
        mock_build_component_scores_sql.assert_not_called()

    @patch(f"{MODULE_PATH}.date")
    @patch(f"{MODULE_PATH}.logger")
    @patch(f"{MODULE_PATH}.build_fisma_all_metrics_aggregate_scores_sql")
    @patch(f"{MODULE_PATH}.rw_util.query_postgres_to_dataframe")
    @patch(f"{MODULE_PATH}.fismaScorecardUtility.load_to_db_and_perform_post_load_validation")
    @patch(f"{MODULE_PATH}.fismaScorecardUtility.archive_to_s3")
    @patch(f"{MODULE_PATH}.build_component_scores_sql")
    def test_fisma_data_present_component_query_returns_none(
        self,
        mock_build_component_scores_sql,
        mock_archive_to_s3,
        mock_load_to_db_and_validate,
        mock_query_postgres_to_dataframe,
        mock_build_fisma_all_metrics_aggregate_scores_sql,
        mock_logger,
        mock_date,
    ):
        """Verify FISMa pipeline runs fully and Component pipeline is skipped when FISMA query returns no data."""
        # Arrange
        engine = MagicMock(name="engine")
        bucket_name = "test-bucket"

        fixed_date = date(2026, 9, 1)
        mock_date.today.return_value = fixed_date

        sql_fisma = "SELECT * FROM fisma_agg"
        mock_build_fisma_all_metrics_aggregate_scores_sql.return_value = sql_fisma

        # Fisma query returns data, Component query returns None
        df_fisma = pd.DataFrame(
            {
                "fisma_id": ["ID1", "ID2"],
                "fisma_name": ["Name1", "Name2"],
                "portfolio": ["Port1", "Port2"],
            }
        )
        mock_query_postgres_to_dataframe.side_effect = [df_fisma, None]

        # Act
        run_aggregate_scores_workflow(engine=engine, bucket_name=bucket_name)

        # Assert: fisma query
        mock_query_postgres_to_dataframe.assert_any_call(
            engine=engine,
            sql_query=sql_fisma,
            params = {"etl_date": fixed_date}
        )

        # Assert: Fisma dataset loading and archival are called
        mock_load_to_db_and_validate.assert_any_call(
            engine=engine,
            df=ANY,
            table="crma_hive_fismascorecard_fisma_system_all_metrics_scores",
            etl_date=fixed_date,
        )
        mock_archive_to_s3.assert_any_call(
            df=ANY,
            bucket_name=bucket_name,
            dataset="crma_hive_fismascorecard_fisma_system_all_metrics_scores",
        )

        # Assert: Componenet SQL should be built once
        mock_build_component_scores_sql.assert_called_once()

        #Assert: Second query 
        self.assertEqual(mock_query_postgres_to_dataframe.call_count, 2)

        #Assert:  Component branch returns None -> warning once more
        mock_logger.warning.assert_called_once_with("Query returned no data")

        # Assert: No Component load/archive when df is None
        self.assertEqual(mock_load_to_db_and_validate.call_count, 1)
        self.assertEqual(mock_archive_to_s3.call_count, 1)

    @patch(f"{MODULE_PATH}.date")
    @patch(f"{MODULE_PATH}.logger")
    @patch(f"{MODULE_PATH}.build_fisma_all_metrics_aggregate_scores_sql")
    @patch(f"{MODULE_PATH}.rw_util.query_postgres_to_dataframe")
    @patch(f"{MODULE_PATH}.fismaScorecardUtility.load_to_db_and_perform_post_load_validation")
    @patch(f"{MODULE_PATH}.fismaScorecardUtility.archive_to_s3")
    @patch(f"{MODULE_PATH}.build_component_scores_sql")
    def test_fisma_and_component_pipelines_run_successfully(
        self,
        mock_build_component_scores_sql,
        mock_archive_to_s3,
        mock_load_to_db_and_validate,
        mock_query_postgres_to_dataframe,
        mock_build_fisma_all_metrics_aggregate_scores_sql,
        mock_logger,
        mock_date,
    ):
        """Confirm both fisma and comoponent pipelines execute fully when data is returned."""
        # Arrange
        engine = MagicMock(name="engine")
        bucket_name = "test-bucket"

        fixed_date = date(2026, 9, 1)
        mock_date.today.return_value = fixed_date


        sql_fisma = "SELECT * FROM fisma_aggs"
        sql_component = "SELECT * FROM component_aggs"
        mock_build_fisma_all_metrics_aggregate_scores_sql.return_value = sql_fisma
        mock_build_component_scores_sql.return_value = sql_component

        df_fisma = pd.DataFrame(
            {
                "fisma_id": ["ID1"],
                "fisma_name": ["Name1"],
                "portfolio": ["Port1"],
            }
        )
        df_component = pd.DataFrame({"col": [1, 2]})

        # First call: fisma DF, second call: component DF
        mock_query_postgres_to_dataframe.side_effect = [df_fisma, df_component]

        # Act
        run_aggregate_scores_workflow(engine=engine, bucket_name=bucket_name)

        # Assert: fisma aggs
        self.assertEqual(mock_build_fisma_all_metrics_aggregate_scores_sql.call_count, 1)

        # Assert: component component aggs
        self.assertEqual(mock_build_component_scores_sql.call_count, 1)

        # Assert: both queries executed
        self.assertEqual(mock_query_postgres_to_dataframe.call_count, 2)

        mock_query_postgres_to_dataframe.assert_any_call(
            engine=engine,
            sql_query=sql_fisma,
            params = {"etl_date": fixed_date}

        )
        mock_query_postgres_to_dataframe.assert_any_call(
            engine=engine,
            sql_query=sql_component,
            params = {"etl_date": fixed_date}
        )

        # Assert: Both FISMA and component loads
        self.assertEqual(mock_load_to_db_and_validate.call_count, 2)
        mock_load_to_db_and_validate.assert_any_call(
            engine=engine,
            df=ANY,
            table="crma_hive_fismascorecard_fisma_system_all_metrics_scores",
            etl_date=fixed_date,
        )
        mock_load_to_db_and_validate.assert_any_call(
            engine=engine,
            df=ANY,
            table="crma_hive_fismascorecard_component_scores",
            etl_date=fixed_date,
        )

        #Assert: Both archival calls
        self.assertEqual(mock_archive_to_s3.call_count, 2)
        mock_archive_to_s3.assert_any_call(
            df=ANY,
            bucket_name=bucket_name,
            dataset="crma_hive_fismascorecard_fisma_system_all_metrics_scores",
        )
        mock_archive_to_s3.assert_any_call(
            df=ANY,
            bucket_name=bucket_name,
            dataset="crma_hive_fismascorecard_component_scores",
        )

        # Assert: No warnings expected when both datasets are present
        mock_logger.warning.assert_not_called()


if __name__ == '__main__':
    unittest.main()
