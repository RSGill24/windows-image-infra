    def fetch_spark_df_from_s3(
        self,
        bucket_name,
        base_folder,
        spark,
    )  :
        """
        Finds the latest timestamped folder under base_folder in S3 and returns a Spark DataFrame
        of all Parquet files in that folder.
        
        Args:
            bucket_name (str): S3 bucket name.
            base_folder (str): Base folder path (e.g., 'raw/tvm/abc').
            spark (SparkSession): Active Spark session.
            logger (optional): Logger for info/error messages.
            
        Returns:
            pyspark.sql.DataFrame or None: DataFrame of all Parquet files in the latest folder, or None if not found.
        """
  
        def _extract_datetime(folder_name):
            """Private helper function to extract datetime from crma_hive folders in s3 storage."""
            pattern = r'_(\d{6})_(\d{6})$'
            match = re.search(pattern, folder_name)
            if match:
                date_str, time_str = match.groups()
                try:
                    return datetime.strptime(date_str + time_str, "%m%d%y%H%M%S")
                except Exception:
                    return None
            return None

        logger.info(f"Collecting latest {base_folder} from {bucket_name}.")
        s3_client = boto3.client("s3")
        paginator = s3_client.get_paginator("list_objects_v2")
        folder_pattern = re.compile(rf"^{re.escape(base_folder)}_(\d{{6}}_\d{{6}})/")
        folders = set()      
  
        
        for page in paginator.paginate(Bucket=bucket_name, Prefix=base_folder):
            for obj in page.get("Contents", []):
                # Creating the object key
                key = obj["Key"]
                match = folder_pattern.match(key)
                if match:
                    folders.add(f"{base_folder}_{match.group(1)}")

        if not folders:
            logger.error(f"No folder with basename, {base_folder} found in bucket {bucket_name}.")
            return None
        
        logger.info(f"Matching folders: {folders}")

        # logger.info("Extract valid folders - Folderst with valid timestamp format as suffix.")
        valid_folders = [f for f in folders if _extract_datetime(f) is not None]
        if valid_folders:
            latest_folder = max(valid_folders, key=lambda f: _extract_datetime(f))
            logger.info(f"Latest folder:{latest_folder}")
        else:
            logger.error(f"No valid timestamped folders found for base name:{base_folder}.")
            return None

        logger.info(f"Reading Parquet files from latest folder")
        path =f"s3://{bucket_name}/{latest_folder}/"
        df = spark.read.parquet(path)

          
        if df is not None:
            logger.info(f"Created Spark dataframe from contents of the folder: {latest_folder}")

        return df
 
    def fetch_spark_df_from_s3_by_date(
            self,
            bucket_name: str,
            base_folder: str,
            spark,
            backfill_date: str,  
        ):
        """
        Finds the latest timestamped folder under base_folder in S3 for the given backfill_date
        (MMDDYY) and returns a Spark DataFrame of all Parquet files in that folder.

        Folder naming pattern (required):
            {base_folder}_{MMDDYY}_{HHMMSS}/

        Args:
            bucket_name (str): S3 bucket name.
            base_folder (str): Base folder path (e.g., 'raw/tvm/abc').
            spark (SparkSession): Active Spark session.
            backfill_date (str): Date string in 'MMDDYY' format. Already validated by caller.

        Returns:
            pyspark.sql.DataFrame or None: DataFrame of all Parquet files in the latest folder
            for that date, or None if no matching folder is found.
        """

        logger.info(
            f"Collecting latest {base_folder} from {bucket_name} for backfill_date={backfill_date}."
        )

        s3_client = boto3.client("s3")
        paginator = s3_client.get_paginator("list_objects_v2")

        # Folder keys are expected like: {base_folder}_{MMDDYY}_{HHMMSS}/...
        folder_pattern = re.compile(
            rf"^{re.escape(base_folder)}_(\d{{6}})_(\d{{6}})/"
        )

        latest_folder = None
        latest_time = None  # HHMMSS as string; lexicographic compare works

        for page in paginator.paginate(Bucket=bucket_name, Prefix=base_folder):
            for obj in page.get("Contents", []):
                key = obj["Key"]
                match = folder_pattern.match(key)
                if not match:
                    continue

                date_part, time_part = match.groups()

                # Only consider folders for the requested backfill_date (MMDDYY)
                if date_part != backfill_date:
                    continue

                folder_name = f"{base_folder}_{date_part}_{time_part}"

                # Track the folder with the latest time for this date
                if latest_time is None or time_part > latest_time:
                    latest_time = time_part
                    latest_folder = folder_name

        if latest_folder is None:
            logger.error(
                f"No folders found for base name {base_folder} on backfill_date {backfill_date} "
                f"in bucket {bucket_name}."
            )
            return None

        logger.info(
            f"Latest folder for {base_folder} on {backfill_date}: {latest_folder} "
            f"(time suffix: {latest_time})."
        )

        path = f"s3://{bucket_name}/{latest_folder}/"
        logger.info(f"Reading Parquet files from folder: {latest_folder}")
        df = spark.read.parquet(path)

        logger.info(f"Created Spark DataFrame from contents of the folder: {latest_folder}")
        return df

    def load_processed_spark_df_to_s3(
            self,
            bucket_name: str, 
            spark: SparkSession,
            prefix: str,
            dataset: str, 
            clean_df: SparkDataFrame, 
            quarantine_df: Optional[SparkDataFrame] = None,
            warning_df: Optional[SparkDataFrame] = None,
            backfill_date: Optional[str] = None 
            )-> None:
        """
        Prepares input params and load to S3 destination folder
        
        Parameters:
            bucket_name (str): Name of the S3 bucket
            spark(SparkSession): pyspark.sql session
            prefix(str): prefix of the destination s3 folder
            dataset(str): name of the dataset to store
            clean_df(SparkDataFrame): The clean dataframe
            quarantine_df(SparkDataFrame): The dataframe with erronous data
            warnning_df(SparkDataFrame): Dataframe with rows containing warning flangs 
            backfill_date (str): Date string used to find which integraiton source file to re-procecss (e.g., 121525)
        Return:
            None
        """
        if backfill_date:
            base_folder = f"processed/TVM/CLEAN/{dataset.count.upper()}_CLEAN"
            target_foldername = self.rw_util.find_or_generate_foldername(
                bucket_name=bucket_name, 
                base_folder=base_folder, 
                backfill_date=backfill_date
                ) 
            path =f"s3://{bucket_name}/{target_foldername}"
            clean_df.write.mode("overwrite").parquet(path)
        
            if quarantine_df is not None:
                base_folder = f"processed/TVM/QUARANTINE/{dataset.count.upper()}_QUARANTINE"
                target_foldername = self.rw_util.find_or_generate_foldername(
                bucket_name=bucket_name, 
                base_folder=base_folder, 
                backfill_date=backfill_date
                ) 
                path =f"s3://{bucket_name}/{target_foldername}"
                quarantine_df.write.mode("overwrite").parquet(path)

            if warning_df is not None:
                base_folder = f"processed/TVM/WARNING/{dataset.count.upper()}_WARNING"
                target_foldername = self.rw_util.find_or_generate_foldername(
                bucket_name=bucket_name, 
                base_folder=base_folder, 
                backfill_date=backfill_date
                ) 
                path =f"s3://{bucket_name}/{target_foldername}"
                warning_df.write.mode("overwrite").parquet(path)  
        else:
            path =f"s3://{bucket_name}/{prefix}/CLEAN/{dataset.upper()}_CLEAN_{datetime.now(timezone.utc).strftime('%m%d%y_%H%M%S')}"
            clean_df.write.mode("overwrite").parquet(path) 

            if quarantine_df is not None:
                path =f"s3://{bucket_name}/{prefix}/QUARANTINE/{dataset.upper()}_QUARANTINE_{datetime.now(timezone.utc).strftime('%m%d%y_%H%M%S')}"
                quarantine_df.write.mode("overwrite").parquet(path) 
   
            if warning_df is not None:
                path =f"s3://{bucket_name}/{prefix}/WARNING/{dataset.upper()}_WARNING{datetime.now(timezone.utc).strftime('%m%d%y_%H%M%S')}"
                warning_df.write.mode("overwrite").parquet(path) 
 

    def bulk_spark_df_upsert_with_jdbc_staging(
        self,
        engine: Engine,
        spark_df,
        schema: str,
        jdbc_url: str,
        user: str,
        password: str,
        target_table: str,
        pk_columns: List[str],
        batch_size: int = 10_000,
        num_partitions: int = None,
    ):
        """
        Efficiently bulk upsert a Spark DataFrame into a PostgreSQL table using:
        1) Spark JDBC write to a staging table
        2) INSERT ... ON CONFLICT upsert from staging into target

        Args:
            engine: SQLAlchemy Engine object (for DDL + upsert SQL).
            spark_df: Spark DataFrame to upsert.
            schema: PostgreSQL schema name (e.g. 'public').
            target_table: Name of the target table (without schema).
            pk_columns: Primary key column names (list of one or more columns).
            jdbc_url: JDBC URL for PostgreSQL
                    e.g. 'jdbc:postgresql://host:5432/dbname'
            jdbc_user: DB user.
            jdbc_password: DB password.
            batch_size: JDBC batch size for Spark writes.
            num_partitions: Optional number of partitions to use when writing.
        """

        # 1. Handle empty DataFrame early
        if spark_df.rdd.isEmpty():
            logger.info("Spark DataFrame is empty. Nothing to upsert.")
            return

        # 2. Generate a unique staging table name (non-temp, so all connections see it)
        unique_suffix = uuid.uuid4().hex[:8]
        staging_table = f"staging_{target_table}_temp_{unique_suffix}"

        columns = spark_df.columns
        if not columns:
            logger.info("Spark DataFrame has no columns. Nothing to upsert.")
            return

        # Quoted column list for SQL
        columns_quoted = [f'"{col}"' for col in columns]
        columns_csv_quoted = ", ".join(columns_quoted)

        conflict_cols = ", ".join(f'"{col}"' for col in pk_columns)
        update_set = ", ".join(
            f'"{col}" = EXCLUDED."{col}"'
            for col in columns
            if col not in pk_columns
        )

        # 3. Create staging table in PostgreSQL with same structure as target
        create_staging_sql = text(
            f'CREATE TABLE "{schema}"."{staging_table}" '
            f' (LIKE "{schema}"."{target_table}" INCLUDING ALL);'
        )

        logger.info(f"Creating staging table {schema}.{staging_table}")
        with engine.begin() as conn:
            conn.execute(create_staging_sql)

        # 4. Write Spark DataFrame to staging table via JDBC
        logger.info(
            f"Writing Spark DataFrame to staging table {schema}.{staging_table} via JDBC"
        )

        df_to_write = spark_df.select(*columns)  # ensure consistent column order
        if num_partitions is not None:
            df_to_write = df_to_write.repartition(num_partitions)

        (
            df_to_write.write
            .format("jdbc")
            .option("url", jdbc_url)
            .option("dbtable", staging_table)  
            .option("currentSchema", schema)   
            .option("user", user)
            .option("password", password)
            .option("driver", "org.postgresql.Driver")
            .option("batchsize", str(batch_size))
            .mode("append")
            .save()
        )

        # 5. Upsert from staging to target table
        upsert_sql = text(
            f'''
            INSERT INTO "{schema}"."{target_table}" ({columns_csv_quoted})
            SELECT {columns_csv_quoted}
            FROM "{schema}"."{staging_table}"
            ON CONFLICT ({conflict_cols})
            DO UPDATE SET {update_set};
            '''
        )

        drop_staging_sql = text(
            f'DROP TABLE IF EXISTS "{schema}"."{staging_table}";'
        )

        try:
            logger.info(
                f"Running upsert from {schema}.{staging_table} to {schema}.{target_table}"
            )
            with engine.begin() as conn:
                conn.execute(upsert_sql)
        except Exception as e:
            logger.error(f"Upsert from staging table failed: {e}")
            # Let the exception propagate after attempting to drop staging table
            raise
        finally:
            # 6. Drop staging table
            logger.info(f"Dropping staging table {schema}.{staging_table}")
            try:
                with engine.begin() as conn:
                    conn.execute(drop_staging_sql)
            except Exception as e:
                logger.warning(
                    f"Failed to drop staging table {schema}.{staging_table}: {e}"
                )

