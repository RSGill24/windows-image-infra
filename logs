import unittest
from unittest.mock import Mock, patch, MagicMock, ANY
import pandas as pd
from datetime import datetime, date, timedelta
import sys

from crma_hive_scorecard_aggregate_scores import (
        build_fisma_all_metrics_aggregate_scores_sql, 
        build_component_scores_sql, 
        run_aggregate_scores_workflow,
    )

MODULE_PATH = "crma_hive_scorecard_aggregate_scores"


class TestScorecardComputeVmScore(unittest.TestCase):
  
    def test_build_fisma_all_metrics_aggregate_scores_sql_returns_string(self):
        sql = build_fisma_all_metrics_aggregate_scores_sql()
        self.assertIsInstance(sql, str)

    def test_build_fisma_all_metrics_aggregate_scores_sql_contains_select(self):
        sql = build_fisma_all_metrics_aggregate_scores_sql()
        self.assertIn("SELECT", sql.upper())

    def test_build_fisma_all_metrics_aggregate_scores_sql_contains_from(self):
        sql = build_fisma_all_metrics_aggregate_scores_sql()
        self.assertIn("FROM", sql.upper())

    def test_build_fisma_all_metrics_aggregate_scores_sql_not_empty(self):
        sql = build_fisma_all_metrics_aggregate_scores_sql()
        self.assertTrue(sql.strip())

    def test_build_fisma_all_metrics_aggregate_scores_sql_returns_string(self):
        sql = build_fisma_all_metrics_aggregate_scores_sql()
        self.assertIsInstance(sql, str)

    def test_build_component_scores_sql_contains_cte(self):
        sql = build_component_scores_sql()
        self.assertIn("WITH", sql.upper())

    def test_build_component_scores_sql_contains_select(self):
