mkdir -p .cloudbuild && cat > .cloudbuild/triggers.yaml << 'EOF'
steps:
  - name: "gcr.io/cloud-builders/docker"
    args:
      - "build"
      - "-t"
      - "us-east4-docker.pkg.dev/$PROJECT_ID/packer-images/windows-packer-builder:latest"
      - "-f"
      - "win2025-software-jira-install-dev/packer/scripts/Dockerfile"
      - "."
images:
  - "us-east4-docker.pkg.dev/$PROJECT_ID/packer-images/windows-packer-builder:latest"

options:
  logging: CLOUD_LOGGING_ONLY
EOF
echo "Created .cloudbuild/triggers.yaml" && git add .cloudbuild/ && git commit -m "Add .cloudbuild/triggers.yaml" && git push origin win2025-folder
