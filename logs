    def select_fields(self, df: pd.DataFrame, cols: list[str]) -> pd.DataFrame:
        """
        Select subset of columns from a dataframe
        
        Parameters:
            df(pd.DataFrame): Input dataframe
            select_cols(list[str]): Columns to keep
        
        Returns:
            pd.DataFrame: Dataframe with only the select columns
        """

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")
        
        return df.loc[:, cols]

    def rename_fields(self, df: pd.DataFrame, rename_map: dict[str, str]) -> pd.DataFrame:
        """
        Rename columns in a dataframe
        
        Parameters:
            df(pd.DataFrame): Input dataframe
            rename_map(dict[str, str]): Rename map
        
        Returns:
            pd.DataFrame: Dataframe with renamed columns
        """
        logger.info("Renaming fields")
        
        valid_map = {old: new for old, new in rename_map.items() if old in df.columns} #Ensures to rename only existing columns
        
        return df.rename(columns=valid_map)

    def clean_date_fields(self, df: pd.DataFrame, cols: list[str]) -> pd.DataFrame:
        """
        Clean and convert date columns to ISO 8601 date format
        
        Parameters:
            df(pd.DataFrame): Input dataframe
            date_columns(list[sr]): list of date columns 
        
        Rules:
            Convert to Datime dtype
            Replace 'TBD' values with null
            Standardize format to 'YYYY-MM-DD'(ISO 8601)
            
        Returns:
            pd.DataFrame: Cleaned dataframe
        """
        logger.info("Applying DQ2: Cleaning and standardizing  date columns to ISO 8601 format.")

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")
        
        for col in cols:
            df[col] = pd.to_datetime(df[col], format='mixed', errors="coerce").dt.date    
        
        return df
    
    def normalize_date_array_fields(self, df: pd.DataFrame, cols: list[str]) ->  pd.DataFrame:
        """
        Normalize mixed list/scalar fields into date list/scalar fields. If list then return date sorted in DESC order.

        Parameters:
            df(pd.DataFrame): Input dataframe
            date_columns(list[sr]): list of date columns 
            
        Returns:
            pd.DataFrame: Cleaned dataframe
        """
        logger.info("Applying: Normalize mixed list/scalr fields into valid ISO 8601 timestamp formats")

        for col in cols:
            if col not in df.columns:
                continue

            def clean_to_list(val):
                # handle missing data
                if pd.isna(val) or val == "":
                    return None
                #turn comma-seperated string to python list
                if isinstance(val, str) and ',' in val:
                    val = [item.strip() for item in val.split(',')]

                # force single values into a list so evertying is a list
                if not isinstance(val, (list, tuple, np.ndarray, set)):
                    val = [val]

                # clean all elements insde list
                parsed_series = pd.to_datetime(pd.Series(list(val)), format='mixed', errors='coerce')

                # extract only vald dates
                clean_dates = parsed_series.dropna().dt.date.tolist()

                if not clean_dates:
                    return None
                
                # sort text in desc order
                clean_dates.sort(reverse=True)

                return clean_dates
            
            df[col] = df[col].apply(clean_to_list)

        return df


