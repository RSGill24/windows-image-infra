# === Paste this in CloudShell (from your terraform/ directory) ===

cd ~/windows-image-infra/terraform

python3 -c "
import re

f = 'functions/process-request/main.py'
with open(f) as fh:
    code = fh.read()

# 1. Remove requests/ prefix check, add audit/status/processed guard
code = code.replace(
    '''    # Only process files in the requests/ prefix
    if not object_name.startswith(\"requests/\"):
        print(f\"[SKIP] Ignoring non-request file: {object_name}\")
        return \"Skipped\", 200''',
    '''    # Skip internal folders (audit, status, processed) to avoid recursive triggers
    if any(object_name.startswith(p) for p in (\"audit/\", \"status/\", \"processed/\")):
        print(f\"[SKIP] Ignoring internal file: {object_name}\")
        return \"Skipped\", 200'''
)

# 2. Fix processed path (both occurrences)
code = code.replace(
    'object_name.replace(\"requests/\", \"processed/\")',
    'f\"processed/{object_name.split(chr(47))[-1]}\"'
)
code = code.replace(
    'object_name.replace(\"requests/\", \"processed/\", 1)',
    'f\"processed/{object_name.split(chr(47))[-1]}\"'
)

# 3. Fix processed path comment
code = code.replace(
    '# Write enriched JSON to /processed/ (not /requests/) for Cloud Run to read',
    '# Write enriched JSON to /processed/ for Cloud Run to read'
)

# 4. Update docstring
code = code.replace(
    'Triggered by Eventarc when a JSON file lands in /requests/.',
    'Triggered by Eventarc when a JSON file lands in the bucket.'
)

with open(f, 'w') as fh:
    fh.write(code)

print('main.py updated successfully!')
"

# Redeploy Cloud Function
terraform apply \
  -target=data.archive_file.process_request_zip \
  -target=google_storage_bucket_object.process_request_source \
  -target=google_cloudfunctions2_function.process_request \
  -auto-approve

echo "Done! Cloud Function redeployed."
