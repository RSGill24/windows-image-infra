    def get_cve_lookup(
        self,
        spark,
        cve_table: str,
        jdbc_url: str,
        user: str,
        password: str,
        fetchsize: int = 10_000,
        driver: str = "org.postgresql.Driver",
    ): 
        """
         Load distinct, normalized CVE IDs from a PostgreSQL CVE table.
        Args:
            spark: Active SparkSession.
            cve_table: Table name, for example "cve" or "public.cve".
            jdbc_url: PostgreSQL JDBC URL.
            user: PostgreSQL username.
            password: PostgreSQL password.
            fetchsize: JDBC fetch size.
            driver: JDBC driver class.

        Returns:
            DparkDataFrame with one column: cve_id.
        """

        if not cve_table:
            raise ValueError("cve_table is required.")

        query = f"""
            (
                SELECT cve_id
                FROM {cve_table}
                WHERE cve_id IS NOT NULL
            ) AS cve_lookup
        """
        try:

          return (
                spark.read.format("jdbc")
                .option("url", jdbc_url)
                .option("dbtable", query)
                .option("user", user)
                .option("password", password)
                .option("driver", driver)
                .option("fetchsize", fetchsize)
                .load()
                .select(F.upper(F.trim(F.col("cve_id"))).alias("cve_id"))
                .dropDuplicates(["cve_id"])
            )

        except Exception as exc:
           raise RuntimeError(
             f"Failed to load CVE lookup data from table '{cve_table}'."              
           ) from exc
            
                 
