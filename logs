         "specific_data.data.last_seen": "devices_last_seen", "specific_data.data.network_interfaces.mac": "devices_mac", "specific_data.data.network_interfaces.ips_v4_preferred": "devices_ips_v4_preferred",
         "specific_data.data.network_interfaces.ips_v6_preferred": "devices_ips_v6_preferred", "specific_data.data.organizational_unit": "devices_organizational_unit", 
         "specific_data.data.os.distribution": "devices_os_distribution", "specific_data.data.os.type": "devices_os_type", "specific_data.data.os.type_distribution":"devices_os_type_distribution", 
         "adapters_data.tenable_io_adapter.asset_uuid": "asset_uuid", "specific_data.data.axonius_classification_identifier.device_type": "devices_type", "adapters_data.gui.custom_devicerole": "devices_custom_devicerole",
         "adapters_data.gui.custom_devicetype": "devices_custom_devicetype", "specific_data.data.enrichment_u_dhs_hva": "devices_enrichment_u_dhs_hva", "adapters_data.crowd_strike_adapter.last_seen": "crowd_strike_last_seen", 
