    def apply_no_duplicates_constraint(self, df: pd.DataFrame, cols: list[str]) -> Tuple[pd.DataFrame, pd.DataFrame]:
        """
        Enforce no duplicates constaint on the given columns 
        
        Parameters:
            df(pd.DataFrame): Input dataframe
            not_nullable_columns: list[str]: List of not nullable columns
        Rules:
            Records with duplicate values in these columns will be removed from df and sent to quarentine_df
        Returns:
            Tuple[pd.DataFrame, pd.DataFrame]: clean and quarantine dataframes 
        """
        logger.info("Applying DQ0: Enforcing no duplicates constainst ")

        missing  = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        duplicate_masks = {col: df.duplicated(subset=[col], keep=False) for col in cols}
        duplicate_mask = pd.concat(duplicate_masks.values(), axis=1).any(axis=1)

        cleaned_df = df[~duplicate_mask].copy()
        quarantine_df = df[duplicate_mask].copy()

        def find_duplicate_columns(row):
            duplicate_columns = [col for col in cols if duplicate_masks[col].get(row.name, False)]
            if duplicate_columns:
                return 'duplicates in ' + ', '.join(duplicate_columns)
            else:
                return ''

        quarantine_df['errors'] = quarantine_df.apply(find_duplicate_columns, axis=1)

        cleaned_df = df[~duplicate_mask].copy()
        
    
        return cleaned_df, quarantine_df
    
    def clean_column_names(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Cleans and converts df columns names to confirm valid columns naming convension
        
        Parameters:
            df(pd.DataFrame): Input dataframe
        Rules:
            Convert to lower case
            Replace spaces and special characters by '_'
            Remove consecutive underscoures 
            Strip leadin/trailing underscores
        Returns:
            pd.DataFrame: Warnning dataframes 
        """
        
        def _clean_name(name):
            name = name.lower()
            name = name.replace(" ", "_")
            name = re.sub(r"[^\w]", "_", name)
            name = re.sub(r"__+", "_", name)
            name = name.strip("_")
            return name

        df.columns = [_clean_name(col) for col in df.columns]
        return df

    def column_has_mixed_list_and_scalar(self, col: pd.Series) -> bool:
        """
        Checks if column has mixed list and scalar values
        
        Parameters:
            col(pd.Series): Input column
        Rules:
            If mixed values return true else 
        Returns:
            bool: flag 
        """ 
        has_list = False
        has_scalar = False
        for val in col:
            if isinstance(val, list):
                has_list = True
            elif pd.notnull(val):
                has_scalar = True
            if has_list and has_scalar:
                return True
        return False
    
    def ensure_list(self, val: str) -> str:
        """
        Checks if column has mixed list and scalar values
        
        Parameters:
            val(str): Input value
        Rules:
            If scalar convert to list
        Returns:
            str: value in list format 
        """
        if isinstance(val, list):
            return val
        elif pd.isnull(val):
            return pd.NA  
        else:
            return [val]
        
    def convert_arrays_for_postgres(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Converts columns containing lists or numpy arrays in a pandas DataFrame to PostgreSQL array literal strings,
        with proper escaping of special characters. Scalar values and nulls are left unchanged.

        This transformation ensures compatibility when inserting data into PostgreSQL array fields.
        Lists and arrays are converted to strings in the format: {"elem1","elem2",...}.
        Escapes backslashes and double quotes in array elements.

        Args:
            df (pd.DataFrame): The input DataFrame to process.

        Returns:
            pd.DataFrame: The DataFrame with array columns converted to PostgreSQL array literal strings.
        """
        
        logger.info("Converting Lists or numpy arrays to postgresql.")

        def _to_pg_array(val):
            if val is None or (isinstance(val, float) and np.isnan(val)):
                return None
            if isinstance(val, (list, np.ndarray)):
                def _escape_elem(x):
                    s = str(x)
                    s = s.replace('\\', '\\\\').replace('"', '\\"')
                    return f'"{s}"'
                return '{' + ','.join(_escape_elem(x) for x in val) + '}'
            return val 

        for col in df.columns:
            if df[col].apply(lambda x: isinstance(x, (list, np.ndarray))).any():
                df[col] = df[col].apply(_to_pg_array).astype('object')
        return df   
    
    def remove_non_printable_chars(self, val): 
        """
        Recursively removes all non-printable characters including NUL, ASCII control codes
        from strings, lists, and numpy arrays to ensure compatibility with PostgreSQL text fields.

        Examples of removed characters include: NUL ('\\x00'), tab ('\\x09'), newline ('\\x0A'), carriage return ('\\x0D'), 
        and other ASCII control codes in the ranges '\\x00'-'\\x1F' and '\\x7F'-'\\x9F'.

        Args:
            val: A string, list, numpy array, or other value.

        Returns:
            The input value with non-printable characters removed from any contained strings.
        """
        if isinstance(val, str):
            return re.sub(r'[\x00-\x1F\x7F-\x9F]', '', val)
        elif isinstance(val, list):
            return [self.remove_non_printable_chars(x) for x in val]
        elif isinstance(val, np.ndarray):
            return np.array([self.remove_non_printable_chars(x) for x in val])
        return val


    def extract_assest_credential_check(self, df: pd.DataFrame, output_col: str) -> pd.DataFrame:
        """
        Enrich df with:
            - credential_check: 'yes'/'no' (string) or NaN
            - scan_start_date: pandas.Timestamp or NaT

        The function:
        - operates in-place on df
        - drops the original details_col
        - returns df for convenience
        """
        logger.info("Extract credential check info from vulns->output field.")

        if output_col not in df.columns:
            raise KeyError(f"Column '{output_col}' not found in DataFrame.")

        # Compile regexes (case-insensitive)
        cred_pattern = re.compile(
            r"credential\w*\s*checks?\s*:\s*(yes|no)\b",
            flags=re.IGNORECASE,
        )
        date_pattern = re.compile(
            r"scan\s*start\s*date\s*:\s*(.+)",
            flags=re.IGNORECASE,
        )

        details_series = df[output_col].astype("string")

        # Extract credential yes/no
        df["credential_check"] = (
            details_series.str.extract(cred_pattern, expand=False).str.lower()
        )

        # Extract and parse scan start date
        df["scan_start_date"] = (
            details_series.str.extract(date_pattern, expand=False).str.lower()
        )
        
        # Drop the original details column
        df.drop(columns=[output_col], inplace=True)

        return df


    def extract_timestamp(self, df: pd.DataFrame, col: str) -> pd.DataFrame:
        """
        Convert a string timestamp column with values like:
            '2026/4/17 8:44 central standard time (utc -05:00)'
            '2026/4/17 5:17 utc '
        into ISO 8601 UTC strings, in-place on `col`.

        After running, df[col] will contain strings like:
            '2026-04-17T13:44:00Z'
        
        """
        logger.info("Extract timestamp from date&time string.")

        if col not in df.columns:
            raise KeyError(f"Column '{col}' not found in DataFrame.")

        # Example patterns:
        # '2026/4/17 8:44 central standard time (utc -05:00)'
        # '2026/4/17 5:17 utc '
        dt_pattern = re.compile(r'^\s*(\d{4}/\d{1,2}/\d{1,2}\s+\d{1,2}:\d{2})', re.IGNORECASE)
        offset_pattern = re.compile(r'\(utc\s*([+-]\d{2}:\d{2})\)', re.IGNORECASE)

        def _parse_single(value):
            if pd.isna(value):
                return pd.NaT

            text = str(value).strip()

            # 1) Extract the date & time part: '2026/4/17 8:44'
            m_dt = dt_pattern.search(text)
            if not m_dt:
                return pd.NaT
            dt_part = m_dt.group(1)

            # 2) Extract UTC offset from '(utc -05:00)', or fall back to 'utc' = +00:00
            m_off = offset_pattern.search(text)
            if m_off:
                offset = m_off.group(1)  # e.g. '-05:00'
            else:
                # If offset info not provided, it is utc time
                offset = '+00:00'

            # 3) Build a parseable string and convert to UTC
            try:
                ts = pd.to_datetime(f"{dt_part} {offset}", format="%Y/%m/%d %H:%M %z")
                ts_utc = ts.tz_convert("UTC")
                return ts_utc
            except Exception:
                return pd.NaT

        # Parse to timezone-aware UTC
        ts_utc_series = df[col].apply(_parse_single)

        # Format as ISO 8601 with 'Z' suffix
        df[col] = ts_utc_series.dt.strftime("%Y-%m-%dT%H:%M:%SZ")

        return df

    def exclude_old_records(self, df: pd.DataFrame, timestamp_col: str, days: int) -> pd.DataFrame:
        """
            Filter a DataFrame in-place to keep rows where `timestamp_col` is within the past `days` days.

            Args:
                df (pd.DataFrame): The DataFrame to filter.
                timestamp_col (str): Name of the column containing timestamps.
                days (int): Number of days to look back from the current time.

            Returns:
                pd.DataFrame: The filtered DataFrame with only records within the past `days` days.

            """       
        logger.info("Exclude old records.")

        if timestamp_col not in df.columns:
            raise ValueError(f"Column '{timestamp_col}' not found in DataFrame.")
        if not isinstance(days, int) or days <= 0:
            raise ValueError("days must be a positive integer.")
        
        df[timestamp_col] = pd.to_datetime(df[timestamp_col], errors='coerce', utc=True)         
        df.drop(df[df[timestamp_col].isna()].index, inplace=True)
        cutoff_date = (datetime.now(timezone.utc) - timedelta(days=days)).date()
        df.drop(df[df[timestamp_col].dt.date < cutoff_date].index, inplace=True)

        return df
    

    def dedup_records(self, df: pd.DataFrame, dedup_col: str, timestamp_col: str) -> pd.DataFrame:
        """
        For each duplicate in `dedup_col`, keep only the row with the latest `timestamp_col`.

        Args:
        df (pd.DataFrame): The DataFrame to filter.
        dedup_col (str): Name of the column containing IDs to deduplicate.
        timestamp_col (str): Name of the column containing timestamps.

        Returns:
            pd.DataFrame: DataFrame with only the latest record per ID.
        """
        logger.info("Removing duplicates.")

        if timestamp_col not in df.columns:
            raise ValueError(f"Column '{timestamp_col}' not found in DataFrame.")
        if dedup_col not in df.columns:
            raise ValueError(f"Column '{dedup_col}' not found in DataFrame.")

        df[timestamp_col] = pd.to_datetime(df[timestamp_col], errors='coerce', utc=True)
        df = df.drop(df[df[timestamp_col].isna()].index)
        df = df.sort_values(by=timestamp_col, ascending=False) 
        df = df.drop_duplicates(subset=dedup_col, keep='first')
        df = df.reset_index(drop=True)

        return df

    def flatten_string_list_columns(self, df, cols):
        """
        Flatten list/array-like values in the specified columns into strings.
        """

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        def flatten_value(x):

            # NumPy array
            if isinstance(x, np.ndarray):
                return ",".join(map(str, x.tolist()))

            # Python list/tuple/set
            if isinstance(x, (list, tuple, set)):
                return ",".join(map(str, x))

            # Already a scalar (string, etc.)
            return x

        for col in cols:
            df[col] = df[col].apply(flatten_value)

        return df

    def standardize_sscg_scorecard(self, df: pd.DataFrame, column: str = 'scorecard') -> pd.DataFrame:
        """
        Standardizes the values in the specified column of a DataFrame to:
        - 'Required for Scorecard'
        - 'Not Required for Scorecard'
        All other values are set to None.

        Args:
            df (pd.DataFrame): The DataFrame to process.
            column (str): The column name to standardize. Default is 'status'.

        Returns:
            pd.DataFrame: The DataFrame with the standardized column.
        """
        def standardize(val):
            v = str(val).strip().lower()
            if 'required for scorecard' in v:
                if 'not' in v:
                    return 'Not Required for Scorecard'
                else:
                    return 'Required for Scorecard'
            else:
                return None
        df[column] = df[column].apply(standardize)
        return df


    def normalize_software_name(
            self, 
            manufacturer: str, 
            product: str
        ) -> str:
        """
        Normalize a software name from manufacturer and product.

        Steps:
        - Combine manufacturer and product into a single string.
        - Convert to lowercase.
        - Replace hyphens and underscores with spaces.
        - Remove non-alphanumeric characters except spaces.
        - Remove corporate suffixes (e.g., inc, corp, llc).
        - Collapse multiple spaces and trim leading/trailing spaces.

        Args:
            manufacturer: Software manufacturer/vendor name.
            product: Software product name.

        Returns:
            A normalized software name as a single lowercase string.
        """
        corp_suffixes = [
        'inc', 'corp', 'llc', 'ltd', 'co', 'company', 'corporation', 'plc', 'gmbh', 'ag', 'sa', 'bv', 'sarl', 'oy', 'pte', 'limited'
        ]

        name = f"{manufacturer} {product}"
        name = name.lower()      # Lowercase
        name = re.sub(r'[-_]', ' ', name)       # Replace hyphens and underscores with spaces
        name = re.sub(r'[^a-z0-9 ]', '', name)       # Remove special characters except spaces
        for suffix in corp_suffixes:                   # Remove corporate suffixes
            name = re.sub(rf'\b{suffix}\b', '', name)
        name = re.sub(r'\s+', ' ', name).strip()        # Clean up extra spaces

        return name

    def normalize_version(
            self,
            version: Optional[str]
        ) -> Optional[str]:
        """
        Normalize a version string into a simplified form.

        Behavior:
        - Accepts None or empty strings and returns None.
        - Strips whitespace.
        - If a colon (:) is present, keeps only the part before the first colon
            (e.g., "2.24.3:extra" -> "2.24.3").
        - Splits on dots (.) and keeps only the first one or two segments:
            - "2.24.3"   -> "2.24"
            - "2.24"     -> "2.24"
            - "2"        -> "2"
        - Returns None if there is no usable content after normalization.

        Args:
            version: Raw version string (may be None).

        Returns:
            A simplified version string (e.g., "2.24") or None if not applicable.
        """
        if not version:
            return None

        v = str(version).strip()
        if not v:
            return None

        # Keep only the part before the first colon
        v = re.split(r":", v)[0].strip()
        if not v:
            return None

        parts = v.split(".")
        if len(parts) >= 2:
            return f"{parts[0]}.{parts[1]}"
        elif parts:
            return parts[0]
        else:
            return None
        
    def flatten_boolean_array_columns(self, df: pd.DataFrame, cols: List[str]) -> pd.DataFrame:
        """
        Flattens specified boolean array columns in a DataFrame to single boolean or None.
        Returns a DataFrame with the columns updated.
        """
        missing  = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        def flatten(arr: List[bool]) -> Optional[bool]:
            return arr[0] if arr else None

        for col in cols:
            df[col] = df[col].apply(flatten)
        return df
    

    def normalize_tvm_os(self, df: pd.DataFrame, raw_os_col: str) -> pd.DataFrame:
        """
        Given a DataFrame and the column name containing raw_os,
        returns a DataFrame with a new normalized_tvm_os column (all lower case).
        """
        def _parse(val):
            """
            Parses a raw_os value that may be a string, list, or PostgreSQL array.
            Returns a list of OS description strings.
            """
            if isinstance(val, str):
                val = val.strip()
                # Handle PostgreSQL array-like string: {"item1","item2"}
                if val.startswith('{') and val.endswith('}'):
                    inner = val[1:-1]
                    items = re.findall(r'"([^"]+)"', inner)
                    if items:
                        return [item.strip() for item in items]
                    return [item.strip().strip('"') for item in inner.split(',')]
                # Try to parse as Python list
                try:
                    parsed = ast.literal_eval(val)
                    if isinstance(parsed, list):
                        return [str(x).strip() for x in parsed]
                except Exception:
                    pass
                return [val]
            elif isinstance(val, list):
                return [str(x).strip() for x in val]
            else:
                return [str(val).strip()]

        def _normalize(entry):
            """
            Normalizes a single OS description string and returns it in lower case.
            """
            entry = entry.strip().lower()

            # Windows Server
            ws_match = re.search(r'windows server (\d{4})', entry)
            if ws_match:
                return f'windows server {ws_match.group(1)}'
            if 'windows server 2012 r2' in entry:
                return 'windows server 2012 r2'
            if 'windows server 2008 r2' in entry:
                return 'windows server 2008 r2'

            # Generic Windows version
            win_match = re.search(r'windows (11|10|8|7|vista|xp)', entry)
            if win_match:
                return f'windows {win_match.group(1)}'

            # Red Hat Enterprise Linux
            rh_match = re.search(r'red hat enterprise linux (\d+\.\d+)', entry)
            if rh_match:
                return f'linux red hat {rh_match.group(1)}'

            # CentOS Linux
            centos_match = re.search(r'centos linux (\d+\.\d+)', entry)
            if centos_match:
                return f'linux centos {centos_match.group(1)}'

            # Ubuntu Linux
            ubuntu_match = re.search(r'ubuntu(?: linux)? (\d+\.\d+)', entry)
            if ubuntu_match:
                return f'ubuntu linux {ubuntu_match.group(1)}'

            # Debian Linux
            debian_match = re.search(r'debian(?: gnu\/linux| linux)? (\d+\.\d+|\d+)', entry)
            if debian_match:
                return f'debian linux {debian_match.group(1)}'

            # Linux Kernel X.Y or X.x
            kernel_match = re.search(r'linux kernel (\d+\.\d+|[1-9]\.x)', entry)
            if kernel_match:
                return f'linux kernel {kernel_match.group(1)}'

            return None  # Use None for unknowns

        def _execute(val):
            if val is None or (isinstance(val, float) and np.isnan(val)) or val == '' or val == []:
                return np.nan
            items = _parse(val)
            if not items or items == ['']:
                return np.nan
            for item in items:
                norm = _normalize(item)
                if norm:
                    return norm.lower()
            # If none matched, return joined string or np.nan
            joined = ', '.join([str(i).strip().lower() for i in items if str(i).strip()])
            return joined if joined else np.nan

        df = df.copy()
        df['normalized_tvm_os'] = df[raw_os_col].apply(_execute)
        return df
