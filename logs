def process_poam_details_report(bucket_name: str, backfill_date: Optional[str] = None) -> None:
    """
    Handles  data cleaning and enrichement of the CSAM poam_details_report 
    
    In backfill mode, fetch the file whose name contains the backfill date and 
    overwrite existing file in /processed prefix.
    
    Parameters:
        bucket_name (str): Name of S3 bucket containing raw and processed integration files
        backfill_date (str): Date string used to find which integraiton source file to re-process (e.g., 121525)

    Returns:
        None
    """
    def _apply_mileston_flags(df: pd.DataFrame) -> pd.DataFrame:
        """Private function to apply milestone flags"""
        warnning_df = df.copy()    
        warnning_df['warnings'] = ''        
        # Apply the condition: If date > Jan 01, 2024 AND milestone = 0, set warning
        warnning_df['warnings'] = warnning_df.apply(
            lambda row: 'number_milestones = 0 for a poam created after 2024-01-01' if pd.to_datetime(row['create_date']) > pd.Timestamp('2024-01-01') and row['number_milestones'] == 0 else '',
            axis=1
        )
        warnning_df = warnning_df[warnning_df['warnings'] != ''] 
        return warnning_df

    logger.info(f"Fetching data from landing zone...")
    
    # Creating variables and the dataframe
    dataset = "POAM_DETAILS_REPORT"
    prefix = "raw_data/CSAM/"
    base_name = prefix + "CRMA_HIVE_CSAM_" + dataset

    if backfill_date:
        df = rw_util.fetch_file_by_date(bucket_name, prefix, base_name, backfill_date, "PARQUET")
    else:
        df = rw_util.fetch_file_from_s3(bucket_name, prefix, base_name, "PARQUET")

    if df is None:
        raise ValueError("No data fetched from landing zone")
    
    target_columns = ["System ID", "System Name", "Acronym", "Portfolio","System Category", "System Operational Status", "System Type", "POAM ID", "POAM Sequence", "POAM Title", "Detailed Weakness Description",  "Created By", "Create Date", 
                      "Days Since Creation", "Scheduled Completion Date", "Planned Start Date", "Actual Start Date", "Planned Finish Date", "Actual Finish Date", "Status", "Weakness", "Cost", "Control Risk Severity", 
                      "User Identified Criticality", "Severity", "Workflow Status", "Workflow Status Date", "Days Until Auto-Approved", "Exclude From OMB", "Accepted Risk", "Assigned To", "Assigned Date", "Delay Reason", "Controls", 
                      "CSFFunction", "CSFCategory", "CSFSubCategory", "Number Milestones", "Number Artifacts", "Item Identified During", "Policy Waiver Approved", "Policy Waiver Expiration", "High Value Asset", "Weakness Comments", 
                      "POA&M Delayed Comments", "POA&M Comments"
                    ]

    logger.info("Selecting target columns...")
    df = dataQualityUtils.select_fields(df, target_columns)

    #Replace '', 'NULL', 'NA' values with null
    df.replace(['', 'NULL', 'NA', 'TBD'], pd.NA, inplace=True)

    #Clean column names:
    df = dataQualityUtils.clean_column_names(df)

    #Rename columns
    map = {"poa_m_comments": "poam_comments", "poa_m_delayed_comments": "poam_delayed_comments"}
    df = dataQualityUtils.rename_fields(df, map)

    #Apply DQ2:Standardize date columns to ISO 8601 format
    cols = [ "actual_finish_date", "actual_start_date", "assigned_date", "create_date", "planned_finish_date", "planned_start_date", "policy_waiver_expiration", "scheduled_completion_date", "workflow_status_date" ]    
    df = dataQualityUtils.clean_date_fields(df, cols)

    #Apply DQ4: Convert numeric columns to Integer 
    cols = ["cost", "days_since_creation", "days_until_auto_approved", "poam_id", "poam_sequence", "system_id", "number_milestones", "number_artifacts" ]
    df = dataQualityUtils.clean_int_fields(df, cols)

    #Apply DQ5: Remove HTML tags.  
    cols = ["poam_comments", "detailed_weakness_description"]
    df = dataQualityUtils.remove_html_tags(df, cols)

    #Apply BR1: Milestone>0 if create_date is after or 2024-01-01, else add to warnning
    warning_df = _apply_mileston_flags(df)  

    #Apply DQ1 & Q: Not nullabe, Quarantine
    cols = ["system_id", "poam_id", "status"]
    df, quarantine_not_null = dataQualityUtils.apply_not_nullable_q_constraint(df, cols)

    #Apply DQ0 & Q: No duplicates & Quarantine
    cols = ["poam_id"]
    df, quarantine_dups = dataQualityUtils.apply_no_duplicates_constraint(df, cols)

    # #Merge quarantine dataframes
    quarantine_df = pd.concat([quarantine_not_null, quarantine_dups], ignore_index=True)

    #Load to destination  
    logger.info("Loading processed data to destination...")
    load_to_processed(bucket_name, dataset, df, quarantine_df, warning_df, backfill_date)

    # #....for testing only ... #
    # load_to_test(bucket_name, dataset, df, quarantine_df, warning_df, backfill_date)
