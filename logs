class WeaknessTrackerPoam:
    """class to help organize things need for a poam based on the WT"""
    def __init__(self, sys_id):
        self.sys_id = sys_id
        self.draft_poam: csam_api_client.PoamUpdate = None
        self.poam: csam_api_client.PoamUpdate = None
        self.draft_milestones = []
        self.milestones = []
        self.assets = None
        self.findings = None
        self.controls = []
        self.iid = None
        self.assignee: csam_api_client.Person = None
        self.isso: csam_api_client.Person = None
        self.number = None
        self.failed = False

    def get_draft_milestones(self):
        if self.poam:
            return [(self.poam.system_id, self.poam.poam_id, m) for m in self.draft_milestones]
        
    def get_draft_iid(self):
        if self.poam and self.iid:
            return self.poam.system_id, self.poam.poam_id, self.iid
        
    def __repr__(self):
        return f"""{self.number}, {self.sys_id}
POA&M: {self.poam}
Assignee: {self.assignee}"""

def wtp_failed_log(logger, wtps, fs: list) -> None:
    if not fs:
        return
    for f in fs:
        idx, draft, exc = f
        wtp = wtps[idx]
        logger.error("POAM Issue with %s: Got '%s'\n\nwhen submitting '%s'", wtp.number, str(exc), draft)

log_failed = partial(wtp_failed_log, unstable_logger)

