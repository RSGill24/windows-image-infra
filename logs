        raise ValueError("No data fetched from landing zone")
    
    target_columns = ["internal_axon_id", "adapters", "adapter_list_length", "labels", "specific_data.data.domain", "specific_data.data.hostname_preferred", "specific_data.data.enrichment_u_acronym", 
