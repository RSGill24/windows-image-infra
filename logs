import logging
import pandas as pd
from datetime import timedelta, date
import urllib3
from crma_hive_utilities import Read_Write_Utility
from crma_hive_connections import Connection


from sqlalchemy.engine import Engine


# Turning off warnings
urllib3.disable_warnings()

# Setting up logger
logger = logging.getLogger(__name__)
logger.setLevel(logging.INFO)

rw_util = Read_Write_Utility()
connection = Connection()


MAIN_SCHEMA = rw_util.MAIN_SCHEMA
METADATA_TABLE = "crma_hive_load_control_metadata"

class FismaScorecardUtility:

    def compute_date_params(
            self,
            etl_date: date
        ) -> dict:
        """
        Compute key date parameters for ETL processing

        Parameters:
            etl_date (date): Reference date for calculations.

        Returns:
            params(dict)L Dictionary of date params
        """
        logger.info(f"Compute query parameters.")

        look_back = etl_date - timedelta(days=31)
        cve_kev_cutoff_date = etl_date - timedelta(days=45)

        return {
            "lookback_date": look_back,
            "cve_kev_cutoff_date": cve_kev_cutoff_date
        }

    def load_to_db_and_perform_post_load_validation(
            self,
            engine: Engine,
            df: pd.DataFrame,
            table: str, 
            etl_date: date
    ) -> None:
        """
        Loads data to desttination database
        
        Parameters:
            engine (create_engine): Database connection engine
            df (pd.DataFrame):
            schema (str):
            table (str):
            load_control_table (str):
        """
        logger.info(f"Loading table '{table}' to '{MAIN_SCHEMA}' schema")

        db_load_flag = rw_util.load_table_to_db_daily_idempotent(
            etl_date=etl_date, 
            engine=engine, 
            df=df, 
            schema_name=MAIN_SCHEMA, 
            table_name=table, 
            load_control_table=METADATA_TABLE, 
            exist_type="append" 
        )
        if db_load_flag: #if loaded, perfoma post load validation
            logger.info(f"Perfomming post load validation on table '{table}' in '{MAIN_SCHEMA}' schema")
            if rw_util.post_load_validation_hist_tables(
                engine=engine, 
                df=df, 
                schema_name=MAIN_SCHEMA, 
                table_name=table, 
                ):
                logger.info(f"Post load validation check passed for table '{table}' in '{MAIN_SCHEMA}' schema")

                ##Parallel loading##
                logger.info("Load copy to 'crmahivedb_fqt' on 'eda-crmahive-np' ")
                logger.info(f"Loading table '{table}' to '{MAIN_SCHEMA}' schema")     
                engine2 = connection.postgres_engine("edae-crma-hive", "crmahivedb_fqt")
                rw_util.load_table_to_db_daily_idempotent(
                    etl_date=etl_date, 
                    engine=engine2, 
                    df=df, 
                    schema_name=MAIN_SCHEMA, 
                    table_name=table, 
                    load_control_table=METADATA_TABLE, 
                    exist_type="append" 
                )

            else:
                raise RuntimeError(f"Post load validation check failed for {table} in '{MAIN_SCHEMA}' schema")

    def archive_to_s3(
            self,
            df: pd.DataFrame,
            bucket_name: str,
            dataset: str
    )->None:
        """
        Load dataset to s3
        params:
            df: dataset to store
            bucket_name: s3 bucket name
            dataset: dataset name
        return:
            None
        """
        logger.info("Load a copy to S3 for archival")
        filename = f"processed/SCORECARD/{dataset.upper()}"
        rw_util.load_to_s3(bucket_name, df, filename, "PARQUET") 

