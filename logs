import urllib3
from datetime import datetime
import logging
import time
from typing import Optional

from sqlalchemy.engine import Engine
from pyspark.sql import SparkSession
from pyspark.sql.functions import current_date


from crma_hive_utilities import Utility, Read_Write_Utility
from crma_hive_connections import Connection
from crma_hive_utilities_spark import Spark_Read_Write_Utility

# Turning off warnings
urllib3.disable_warnings()

# Setting up logger
logger = logging.getLogger()
logger.setLevel(logging.INFO)

# Instantiate classes
connection = Connection()
utility = Utility()
rw_util = Read_Write_Utility()
spark_rw_util = Spark_Read_Write_Utility()

MAIN_SCHEMA = rw_util.MAIN_SCHEMA


def load_to_db(
        spark: SparkSession,
        jdbc_url: str,
        user: str,
        password: str, 
        bucket_name: str, 
)->None:
    """
    Prepares input parametrs and calls utility function to load TVM data to target talbes in Normal mode.

    Parameters:
        engine (str): SQLalchemy engine
        schema (str): The database schema in which data is loaded.
        bucket_name (str): Name of S3 bucket containing raw and processed integration files   
    Returns:
        None
    """    
    logger.info("Fetch data from ")
    base_folder = f"raw_data/SNOW/CRMA_HIVE_SNOW_POAM_FINDINGS"
    df = spark_rw_util.fetch_spark_df_from_s3(
        bucket_name=bucket_name, 
        base_folder=base_folder,
        spark=spark,
        )
    
    if df is not None:
        logger.info(f"Total records fetched: {df.count()}")
        df = df.withColumn("etl_date", current_date())

    else: 
        logger.info("No data received")
        raise
    

    logger.info("Loading  data to target table")
    spark_rw_util.bulk_spark_df_load_with_jdbc(
        spark_df=df,
        schema=MAIN_SCHEMA,
        jdbc_url=jdbc_url,
        user=user,
        password=password,
        target_table="crma_hive_snow_wtt_poam_findings"
    )

    
    ##Parallel loading##
    logger.info("Load copy to 'crmahivedb_fqt' on 'eda-crmahive-np' ")
    jdbc_url2, user2, password2 = connection.parse_pg_uri_to_jdbc("edae-crma-hive", "crmahivedb_fqt")
    spark_rw_util.bulk_spark_df_load_with_jdbc(
        spark_df=df,
        schema=MAIN_SCHEMA,
        jdbc_url=jdbc_url2,
        user=user2,
        password=password2,
        target_table="crma_hive_snow_wtt_poam_findings"
    )
    

def main():
    start_time = time.time()
    utility.log_memory_usage() 

    jdbc_url, user, password = connection.parse_pg_uri_to_jdbc("edae-crma-hive")

    try: 
        bucket_name = connection.get_secret("edae-crma-hive")["lz_bucket_name"]  
    except Exception as e:
       logger.error(f"Error retrieving bucket name:{e}")   
       raise     
    try: 
        spark= SparkSession.builder.getOrCreate()
    except Exception as e:
       logger.error(f"Error creating spark session:{e}")   
       raise  

    

    load_to_db(
        spark=spark,
        jdbc_url=jdbc_url,
        user=user,
        password=password, 
        bucket_name = bucket_name, 
    )    

    elapsed_minutes = (time.time() - start_time)/60
    logger.info(f'Complete. Total elapsed time : {elapsed_minutes}')


if __name__ == "__main__":
    main()
