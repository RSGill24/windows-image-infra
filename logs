def build_device_vm_score_sql() -> str:
    """
    Build the VM Score per device data preparation SQL Command using CTEs.
    """

    sql = f"""
        WITH 
        -- Step 1: Select Eligible devices
        eligible_devices AS (
            SELECT 
                device_id,
                fisma_id,
                preferred_hostname AS hostname, 
                preferred_ipv4  AS ip,
                devicerole,
                device_last_seen,
                asset_id,
                is_credentialed,
                last_authenticated_scan_date
            FROM  crma_hive.crma_hive_fismascorecard_input_devices 
            WHERE devicerole IN ('ENDPOINT','NETWORKING DEVICE')
                AND fisma_id iLIKE 'ICE-%%'
        ),
        -- Step 2: Dedup asset_id 
                -- group by asset_id -> rank by device_last_seen, keep top ranked
        deduped_eligible_devices AS(	
            SELECT *
            FROM (
                SELECT *,
                    ROW_NUMBER() OVER (
                        PARTITION BY asset_id
                        ORDER BY device_last_seen DESC
                    ) AS asset_rn
                FROM eligible_devices
                WHERE asset_id IS NOT NULL
            ) ranked
            WHERE asset_rn = 1 
            UNION ALL
            SELECT *,
                NULL AS asset_rn
            FROM eligible_devices
            WHERE asset_id IS NULL
        ),
        -- Step 3: Get eligibile scans
        flattened_vulns AS (
            -- 3.1: Flatten
            SELECT
                v.finding_id,
                v.asset_uuid AS asset_id,
                v.last_found,
                v.state,
                TRIM(cve) AS cve_id
            FROM crma_hive.crma_hive_tvm_vulns v
            CROSS JOIN LATERAL UNNEST(v.plugin_cve) AS cve
            WHERE
                v.plugin_cve IS NOT NULL
                AND array_length(v.plugin_cve, 1) > 0
                AND v.state IN ('OPEN', 'REOPENED')
        ),
        ranked_vulns AS (
            -- 3.2: Flatten	
            SELECT
                finding_id,
                asset_id,
                last_found,
                state,
                cve_id,
                ROW_NUMBER() OVER (
                    PARTITION BY asset_id, cve_id
                    ORDER BY last_found DESC
                ) AS rn
            FROM flattened_vulns
        ),
        latest_vulns AS (
            -- 3.3: Dedup: Keep latest in case of duplicate asset_uuid&cve combination
            SELECT
                finding_id,
                asset_id,
                last_found,
                state,
                cve_id
            FROM ranked_vulns
            WHERE rn = 1
        ),
        -- Step 4: Enrich vulns with CVE NVD/KEV data
                -- Where cve published date is on/before 15th of last calander month
        enriched_vulns AS (
            SELECT
                lv.finding_id,
                lv.asset_id,
                lv.last_found,
                lv.state,
                lv.cve_id,
                ck.cvss_v3_score,
                ck.published     AS cve_published_date,
                ck.last_modified AS cve_last_modified_date,
                ck.is_kev,
                ck.date_added AS kev_date_added,
                ck.due_date AS kev_due_date
            FROM latest_vulns lv
            LEFT JOIN crma_hive.crma_hive_cve_score_kev_info_combined ck
                ON lv.cve_id = ck.cve_id
            WHERE ck.published  <= %(cve_kev_cutoff_date)s
        ),
        -- Step 5: Left Join eligibile_devices and enriched_vulns  on asset_uuid 
        eligible_devices_cves AS (
            SELECT
                ed.device_id,
                ed.fisma_id,
                ed.hostname,
                ed.ip,
                ed.devicerole,
                ed.asset_id,
                ed.device_last_seen,
                ed.is_credentialed,
                ed.last_authenticated_scan_date,
                ev.finding_id,
                ev.state                 AS finding_state,
                ev.cve_id,
                ev.cvss_v3_score,
                ev.cve_published_date,
                ev.cve_last_modified_date,
                ev.is_kev,
                ev.kev_date_added,
                ev.kev_due_date
            FROM deduped_eligible_devices ed
            LEFT JOIN enriched_vulns  ev
                ON ed.asset_id = ev.asset_id
        ),
        -- Step 6: compute per device aggregates 
        per_device_aggs AS (
            SELECT
                device_id,
                MAX(hostname) AS hostname,
                MAX(ip)  As ip,
                MAX(asset_id) AS asset_id,
                MAX(fisma_id) AS fisma_id,
                MAX(device_last_seen) AS device_last_seen,	
                COALESCE(BOOL_OR(is_credentialed), FALSE) AS is_credentialed,
                MAX(last_authenticated_scan_date) AS last_authenticated_scan_date,
                COALESCE(
                    BOOL_OR(is_kev AND kev_date_added <= %(cve_kev_cutoff_date)s),
                    FALSE
                ) AS has_eligible_kev,
            
                COUNT(*) FILTER (
                    WHERE is_kev = TRUE AND kev_date_added <= %(cve_kev_cutoff_date)s
                ) AS eligible_kev_cve_count,

                SUM(
                    CASE
                        WHEN cvss_v3_score BETWEEN 7.0 AND 8.9 THEN 1
                        ELSE 0
                    END
                ) AS high_cve_count,
                SUM(
                    CASE
                        WHEN cvss_v3_score BETWEEN 9.0 AND 10.0 THEN 1
                        ELSE 0
                    END
                ) AS critical_cve_count, 

                ARRAY_AGG(cve_id) FILTER (WHERE cvss_v3_score BETWEEN 7.0 AND 8.9) AS high_cves,

                ARRAY_AGG(cve_id) FILTER (WHERE cvss_v3_score BETWEEN 9.0 AND 10.0) AS critical_cves,

                ARRAY_AGG(cve_id) FILTER (WHERE is_kev AND kev_date_added <= %(cve_kev_cutoff_date)s) AS eligible_kev_cves,


                ARRAY_AGG(finding_id) FILTER (WHERE finding_id IS NOT NULL) AS finding_ids

            FROM eligible_devices_cves
            GROUP BY device_id
        ),
        -- Step 7: Compute Device VM Score
        device_vm_scores AS (
            SELECT 
                device_id,
                hostname,
                ip,
                asset_id,
                fisma_id,
                device_last_seen,
                is_credentialed,
                last_authenticated_scan_date,
                has_eligible_kev,
                high_cve_count,
                eligible_kev_cve_count,
                critical_cve_count,
                high_cves,
                critical_cves,
                eligible_kev_cves,
                finding_ids,
                CASE
                    WHEN NOT is_credentialed OR has_eligible_kev THEN 0
                    ELSE GREATEST(
                        100 - (LEAST(critical_cve_count * 10, 50) + LEAST(high_cve_count * 5, 50)),
                        0
                    )
                END AS vm_score
            FROM per_device_aggs
        ),
        -- Step 8: Enrich with FISMA system information
        device_vm_scores_enriched AS (
            SELECT 
                dvs.device_id,
                dvs.hostname,
                dvs.ip,
                dvs.fisma_id,
                fd.fisma_name,
                fd.security_support_portfolio AS portfolio,
                fd.dhs_hva,
                fd.public_facing,
                fd.cfo_designated,
                fd.fips_199_security_categorization_overall,
                fd.active,
                fd.iscm_waiver, 
                fd.fisma_reportable,
                fd.fisma_inventory_selc_status,
                fd.fisma_category,
                dvs.device_last_seen,
                dvs.asset_id,
                dvs.is_credentialed,
                dvs.last_authenticated_scan_date,
                dvs.has_eligible_kev,
                dvs.eligible_kev_cve_count,
                dvs.eligible_kev_cves,
                dvs.high_cves,
                dvs.high_cve_count,
                dvs.critical_cves,
                dvs.critical_cve_count, 
                dvs.finding_ids,
                dvs.vm_score     
            FROM device_vm_scores dvs
            LEFT JOIN crma_hive.crma_hive_snow_fismadetails fd
                ON dvs.fisma_id = fd.fisma_id
        )

        SELECT 
            device_id,
            hostname,
            ip,
            fisma_id,
            fisma_name,
            portfolio,
            dhs_hva,
            public_facing,
            cfo_designated,
            fips_199_security_categorization_overall,
            active,
            iscm_waiver, 
            fisma_reportable,
            fisma_inventory_selc_status,
            fisma_category,
            device_last_seen,
            asset_id,
            is_credentialed,
            last_authenticated_scan_date,
            has_eligible_kev,
            eligible_kev_cve_count,
            eligible_kev_cves,
            high_cves,
            high_cve_count,
            critical_cves,
            critical_cve_count, 
            finding_ids,
            vm_score 
        FROM device_vm_scores_enriched

    """
    return sql

def build_fisma_vm_score_sql() -> str:
    """
    Build the VM Score per FISMA System data preparation SQL Command using CTEs.
    """
    sql = f"""
        WITH
        fisma_vm_score AS (
            SELECT 
                fisma_id,
                ROUND(AVG(vm_score))::integer AS vm_score
            FROM crma_hive.crma_hive_fismascorecard_device_vm_score  
            WHERE etl_date = %(etl_date)s
            GROUP BY fisma_id
        )
        SELECT 
            a.fisma_id,
            a.fisma_name,
            a.security_support_portfolio AS portfolio,
            a.dhs_hva,
            a.public_facing,
            a.cfo_designated,
            a.fips_199_security_categorization_overall,
            a.active,
            a.iscm_waiver,
            a.fisma_reportable,
            a.fisma_inventory_selc_status,
            a.fisma_category,
            b.vm_score
        FROM crma_hive.crma_hive_snow_fismadetails a
        LEFT JOIN fisma_vm_score b
            ON a.fisma_id = b.fisma_id

    """

    return sql


def run_vm_score_workflow(
        engine: Engine,
        bucket_name: str
    )->None:
    """
    Execute the vulnerability management score workflow, including building query to fetch input data, 
    param preparation, execute query, score, store output.

    Parameters:
        engine (Engine): Database engine for data access.
        bucket_name (str): Name of the storage bucket for output.

    Returns:
        None
    """
    etl_date= date.today()
    logger.info(f"Computing Scorecard VM Score for : {etl_date}") 

    params = fismaScorecardUtility.compute_date_params(etl_date)
    params.pop("lookback_date", None)
    logger.info("CVE/KEV cutoff date: %s", params["cve_kev_cutoff_date"])

    logger.info("Build query to fetch Device VM score input data.")
    sql = build_device_vm_score_sql()


    logger.info("Excecute query to fetch Device VM score input data.")
    df = rw_util.query_postgres_to_dataframe(
        engine=engine,
        sql_query=sql,
        params=params
    )

    if df is not None:
        logger.info(f"Per device Vm score received. Total number of devices: {len(df)}")         
        logger.info(f"Load device score dataset to target table.")
        df["etl_date"] = etl_date
        dataset = "crma_hive_fismascorecard_device_vm_score"
        fismaScorecardUtility.load_to_db_and_perform_post_load_validation(
            engine=engine,
            df=df,
            table=dataset,
            etl_date=etl_date
        )

        fismaScorecardUtility.archive_to_s3(
            df=df,
            bucket_name=bucket_name,
            dataset=dataset
        )

    else:
        logger.warning("Query returned no data")   
        return 

    logger.info("Build query to fetch FISMA System VM score data.")
    sql = build_fisma_vm_score_sql()

    logger.info("Excecute query to fetch FISMA System VM score data.")
    df = rw_util.query_postgres_to_dataframe(
        engine=engine,
        sql_query=sql,
        params={"etl_date": etl_date}
    )

    if df is not None:       
        logger.info(f"Load FISMA System VM score dataset to target table and save a copy to S3 for archival.")
        df["etl_date"] = etl_date 
        dataset='crma_hive_fismascorecard_fisma_system_vm_score'
        fismaScorecardUtility.load_to_db_and_perform_post_load_validation(
            engine=engine,
            df=df,
            table=dataset,
            etl_date=etl_date
        )

        fismaScorecardUtility.archive_to_s3(
            df=df,
            bucket_name=bucket_name,
            dataset=dataset
        )
       
    else:
        logger.warning("Query returned no data")      
         

def main():

    start_time = time.time()
    utility.log_memory_usage() 

    bucket_name = connection.get_secret("edae-crma-hive")["lz_bucket_name"]
    engine = connection.postgres_engine("edae-crma-hive") 


    run_vm_score_workflow(engine=engine, bucket_name=bucket_name)       
      
    utility.log_memory_usage() 
    elapsed_minutes = (time.time() - start_time) / 60 
    logger.info(f"Complete. Total elapsed time : {elapsed_minutes}")


if __name__ == "__main__":
    main()
