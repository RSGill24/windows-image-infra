    def remove_html_tags(self, df: pd.DataFrame, cols: list[str]) -> pd.DataFrame:
        """
        Clean columns with html tags
        
        Parameters:
            df(pd.DataFrame): Input dataframe
            html_columns(list[sr]): list of columns values with html tags
        Rules:
            Remove HTML tags
        Returns:
            pd.DataFrame: Cleaned dataframe
        """
        logger.info("Apply DQ5: Removing HTML tags .")

        missing  = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")
        
        html_tag_re = re.compile(r"<.*?>")
        def strip_tags(value):
            if pd.isna(value):
                return pd.NA
            text = re.sub(html_tag_re, "", str(value))
            return " ".join(text.split()) if text.strip() else pd.NA
            
        for col in cols:
            df[col] = df[col].apply(strip_tags).astype("string")

        return df

    def flatten_json_object(self, df: pd.DataFrame, col: str, key: str) -> pd.DataFrame:
        """
        Flatten json objects 
        
        Parameters:
            df(pd.DataFrame): Input dataframe
            col(str): Column with json value
            key(str): the key to the select value
        Rules:
            Flatten json to selected field
        Returns:
            pd.DataFrame: Cleaned dataframe
        """
        logger.info("Applying DQ7: Flattening JSON objects")

        if col not in df.columns:
            logger.error(f"Column {col} not in dataset")
            raise KeyError(f"Column {col} not in dataset")
    
        def extract_key(value):
            if pd.isna(value):
                return pd.NA
            
            if isinstance(value, dict):
                return value.get(key, pd.NA)
            
            if isinstance(value, str):
                val = value.strip()
                try:
                    obj = json.loads(val)
                    if isinstance(obj, dict):
                        return obj.get(key, pd.NA)
                except json.JSONDecodeError:
                    pass
                
                try:
                    obj = ast.literal_eval(val)
                    if isinstance(obj, dict):
                        return obj.get(key, pd.NA)
                except Exception:
                    return pd.NA
                
            return pd.NA
        
        df[col] = df[col].apply(extract_key).astype("string") 

        return df

    def flatten_nested_columns(
            self,
            df: pd.DataFrame, 
            cols_to_pars: dict
            ) -> pd.DataFrame:
        """
        Flattens specified nested dictionary columns in a DataFrame.

        Args:
            df (pd.DataFrame): Input DataFrame containing nested dictionary columns.
            cols_to_pars (dict): Mapping of parent column names to lists of child field names.

        Returns:
            pd.DataFrame: DataFrame with new flattened columns and original parent columns removed.

        """
        logger.info("Flattening nested dictionary columns.")

        for parent_col, child_cols in cols_to_pars.items():
            if parent_col not in df.columns:
                raise KeyError(f"Column '{parent_col}' not found in DataFrame.")
            
            for child_col in child_cols:
                new_col_name = f"{parent_col}_{child_col}"
                df[new_col_name] = df[parent_col].apply(
                    lambda x: x.get(child_col) if isinstance(x, dict) else None
                )
        df = df.drop(columns=list(cols_to_pars.keys()))
        return df

    def apply_not_nullable_q_constraint(self, df: pd.DataFrame, cols: list[str]) -> Tuple[pd.DataFrame, pd.DataFrame]:
        """
        Enforce not nullable constariant on the given columns 
        
        Parameters:
            df(pd.DataFrame): Input dataframe
            not_nullable_columns: list[str]: List of not nullable columns
        Rules:
            Raws with null values are removed from df and sent to quarentine_df
        Returns:
            Tuple[pd.DataFrame, pd.DataFrame]: clean and quarantine dataframes 
        """
        logger.info("Applying DQ1: Enforcing Not Nullable constainst ")

        missing  = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")
        
        quarantine_df = df[df[cols].isnull().any(axis=1)].copy()
        quarantine_df['errors'] = quarantine_df[cols].apply(lambda row: 'null values in ' + ', '.join([col for col in cols if pd.isnull(row[col])]), axis=1) 

        cleaned_df = df.dropna(subset=cols).copy()

        return cleaned_df, quarantine_df

