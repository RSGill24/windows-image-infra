
CREATE TABLE IF NOT EXISTS crma_hive.crma_hive_fismascorecard_input_devices(
	device_id text,
	fisma_id text,
	device_last_seen timestamp,
	device_type text,
	devicerole text,
	devicetype text,
	asset_auth_status text,
	asset_hosting text,
    preferred_serial_number text,
    mac text[],
	preferred_hostname text,
	preferred_ipv4 text,
	preferred_os text,
	os text[],
	adapters text[],
	crowd_strike_last_seen date,
	crowd_strike_adapter_policies_policy_type text[],
    crowd_strike_adapter_policies_applied text[],
	edr_enabled boolean,
	asset_id text,
	asset_last_scan_time timestamp,	
	last_authenticated_scan_date timestamp,
	is_credentialed boolean,
    etl_date date
);

CREATE INDEX idx_fismascorecard_device_details_etl_date ON crma_hive.crma_hive_fismascorecard_input_devices USING BRIN (etl_date);
CREATE INDEX idx_fismascorecard_device_details_fisma_id ON crma_hive.crma_hive_fismascorecard_input_devices (fisma_id);
CREATE INDEX idx_fismascorecard_device_details_asset_id_last_scan ON crma_hive.crma_hive_fismascorecard_input_devices (asset_id, asset_last_scan_time);
