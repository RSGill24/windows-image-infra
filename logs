         "specific_data.data.serial_number_preferred": "devices_serial_number_preferred", "adapters_data.gui.custom_asset_auth_status": "devices_custom_asset_auth_status", 
         "adapters_data.gui.custom_asset_hosting": "devices_custom_asset_hosting"
        }
    df = dataQualityUtils.rename_fields(df, map)

    #Remove non-printerbal characters
    logger.info("Removing non-printable characters from string literals.")
    df = df.map(dataQualityUtils.remove_non_printable_chars)


    #Flatten select list/numpy array/set fields to str 
    cols = ["devices_enrichment_u_dhs_hva"]
    df = dataQualityUtils.flatten_string_list_columns(df, cols) 

