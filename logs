            cat = "|".join(findings_df.filter(pl.col('state'+ft_suffix).ne('mitigated'))['cat'+ft_suffix].drop_nulls().unique())
            plugin_names = f"{f'CAT {cat} ' if cat else ''}{stig_cis} {_type.split("_")[0].upper()} Compliance Findings"
