    def bulk_spark_df_load_to_hist_tables_with_jdbc_daily_idempotent(
        self,
        etl_date: date,
        spark_df,
        schema: str,
        engine: Engine,
        jdbc_url: str,
        user: str,
        password: str,
        target_table: str,
        load_control_table: str,
        batch_size: int = 10_000,
        num_partitions: int = None,
    ):
        """
        Efficiently bulk loads a Spark DataFrame into a staging PostgreSQL table using Spark JDBC write
    
        Args:
            spark_df: Spark DataFrame to load.
            schema: PostgreSQL schema name (e.g. 'public').
            target_table: Name of the target table (without schema).
            jdbc_url: JDBC URL for PostgreSQL
                    e.g. 'jdbc:postgresql://host:5432/dbname'
            user: DB user.
            password: DB password.
            batch_size: JDBC batch size for Spark writes.
            num_partitions: Optional number of partitions to use when writing.
        """

        if spark_df.rdd.isEmpty():
            logger.info("Spark DataFrame is empty. Nothing to load.")
            return

        columns = spark_df.columns
        if not columns:
            logger.info("Spark DataFrame has no columns. Nothing to load.")
            return

        #initialize
        db_load_flag =True
       
        conn = engine.raw_connection()
        cur = None
        try:
             #1: register today's load
            cur = conn.cursor()
            if schema == self.MAIN_SCHEMA:
                cur.execute(
                    f"""
                        INSERT INTO {schema}.{load_control_table} (table_name, etl_date)
                        VALUES (%s, %s)
                        """,
                       (target_table, etl_date)                        
                    )
                conn.commit() 

            #2: load
            df_to_write = spark_df.select(*columns)  # ensure consistent column order
            if num_partitions is not None:
                df_to_write = df_to_write.repartition(num_partitions)      
       
            (
                df_to_write.write
                .format("jdbc")
                .option("url", jdbc_url)
                .option("dbtable", f"{schema}.{target_table}")  
                .option("user", user)
                .option("password", password)
                .option("driver", "org.postgresql.Driver")
                .option("batchsize", str(batch_size))
                .mode("append")
                .save()
            )
        except psycopg2.errors.UniqueViolation as e:
            logger.info(f"Table, {target_table}, already loaded for {etl_date}. Skipping loading.")
            db_load_flag = False
        except Exception as e:
            logger.error(f"Error loading spark df to db: {e}")
            raise
        finally:
            if cur is not None:
                try:
                    cur.close()
                except Exception:
                    pass
            conn.close()
        
        return  db_load_flag 



    def post_load_validation_spark_df(
        self,
        engine: Engine,
        spark_df: SparkDataFrame,
        schema_name: str,
        table_name: str,
    ) -> bool:
        """
        Perform post-load validation to verify the number of records in the Spark DataFrame
        matches the number of records in the PostgreSQL table.

        Parameters:
            engine: SQLAlchemy engine to connect to Postgres.
            spark_df: The Spark DataFrame that was loaded into the database.
            schema_name: Schema where the table resides in Postgres.
            table_name: Table name in Postgres.

        Returns:
            bool: True if the record counts match, False otherwise.
        """
        try:
            # This triggers a Spark job to count the DF rows
            df_record_count = spark_df.count()

            with engine.connect() as connection:
                query = text(f'SELECT COUNT(*) FROM "{schema_name}"."{table_name}";')
                result = connection.execute(query)
                table_record_count = result.scalar()

            if df_record_count == table_record_count:
                logger.info(
                    f"Post-load validation passed for {schema_name}.{table_name}: "
                    f"{df_record_count} records in Spark DF and table."
                )
                return True
            else:
                logger.error(
                    f"Post-load validation check failed for {schema_name}.{table_name}! "
                    f"Spark DataFrame contains {df_record_count} records but "
                    f"{table_record_count} records are present in the table!"
                )
                return False

        except Exception as e:
            logger.error(
                f"Error during post-load validation for {schema_name}.{table_name}: {e}",
                exc_info=True,
            )
            raise
   
