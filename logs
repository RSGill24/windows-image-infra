import csam_api_client
from functools import partial
from weakness_tracking_poams_create import WeaknessTrackerPoam, wtp_failed_log
import uuid
import os

from csam_helpers import (
    CSAM_CONFIG,
    submit_to_csam,
    post_poam_workflow,
    created_by_rise,
    get_poam_level_api_call,
    put_draft_poam_milestone,
    post_poam_findings_mitigated_list,
    put_poam_update,
    CLOSURE_WORFLOW,
    csam_retry
)

from snow_helpers import (
    get_n_transform_snow,
    SNOW_POAM_TABLE_NAME,
    SNOW_WEAKNESS_TRACKING_TABLE_NAME,
    SNOW_FINDINGS_TABLE_NAME,
)

import logging
from lib import set_file_handler, set_stream_handler, set_unstable, get_unstable_logger
import datetime
import polars as pl

from functools import lru_cache

_name = "sara_wt_poam_closure_automation"
logger = logging.getLogger(_name)
logger.propagate=False
logger.setLevel(logging.DEBUG)

logger = set_file_handler(logger, f"{_name}.log")
logger = set_stream_handler(logger)

unstable_logger, unstable_fn_path = get_unstable_logger(_name)

log_failed = partial(wtp_failed_log, unstable_logger)

def get_run_id() -> str:
    return uuid.uuid4().hex


def _run(run_id):
    today = datetime.date.today()

    csam_api = csam_api_client.ApiClient(CSAM_CONFIG)
    systems_api = csam_api_client.SystemsApi(csam_api)

    @lru_cache
    def get_system_acronym(sys_id):
        system = csam_retry(systems_api.v1_systems_id_get)(sys_id)
        return system.acronym

    # get snow poam table to correlate

    # all_poam_df = pl.DataFrame([poam.to_dict() for poams in poams_by_system_id.values() for poam in poams], infer_schema_length=None)
    # need to get the latest WTs that are closed_complete with a poa_m_id
    test_wts_fn = os.path.join("tests", "test_wt_closed.parquet")
    try:
        closed_weakness_trackers = pl.read_parquet(test_wts_fn)
    except FileNotFoundError:
        closed_weakness_trackers = get_n_transform_snow(SNOW_WEAKNESS_TRACKING_TABLE_NAME, offset_limit=5000, fields=[], sysparm_query="state=closed_complete^poa_m_idISNOTEMPTY")

    # snow_poams = get_latest_snow_table(SNOW_POAM_TABLE_NAME, SNOW_API, offset_limit=5000)

    # systems = systems_api.v1_systems_get()
    # systems_ids = [x.id for x in systems]
    system_poam_api = csam_api_client.PoamDetailsApi(csam_api)
    # poams_by_system_id = get_system_level_api_call(system_poam_api.v1_systems_system_id_poams_get, systems_ids)
    # poams = {poam.poam_id: poam for poams in poams_by_system_id.values() for poam in poams}
    
    # closed_weakness_trackers = closed_weakness_trackers.join(snow_poams['sys_id', 'poam_id'], left_on=pl.col('poa_m_id').struct.field('value'), right_on="sys_id")
    # closed_weakness_trackers = closed_weakness_trackers.with_columns(
        # pl.col('poam_id').cast(pl.Int32)
    # )

    if closed_weakness_trackers.is_empty():
        logger.info("No closed WTs with POAMs")
        return

    # # get findings related to closed WT that have a poa_m_id
    # test_findings_fn = os.path.join("tests", "test_findings_closed.parquet")
    # try:
    #     closed_findings = pl.read_parquet(test_findings_fn)
    # except FileNotFoundError:
    #     closed_findings = []
    #     for sys_id in closed_weakness_trackers['sys_id']:
    #         closed_findings.append(get_n_transform_snow(SNOW_FINDINGS_TABLE_NAME, offset_limit=5000, fields=[], sysparm_query=f"weakness_tracking={sys_id}"))
    #     closed_findings = pl.concat(closed_findings)

    # set of (system_id, poam_id) that need closing
    to_close = []
    poam_findings = {}
    poam_status = csam_api_client.PoamStatus
    closed_statuses = {poam_status.COMPLETED, poam_status.CANCELLED}
    for wt_number, wt_sys_id, poam_id, total_findings in closed_weakness_trackers['number', 'sys_id', 'poa_m_id', 'total_findings'].rows():
        log_ctx = {"run_id": run_id, "weakness": wt_number}

        snow_poam = get_n_transform_snow(
        SNOW_POAM_TABLE_NAME,
        offset_limit=1,
        limit=1,
        fields=["csam_id", "poam_id"],
        sysparm_query=f"sys_id={poam_id['value']}",
    )
        try:
            csam_id = int(snow_poam["csam_id"].item())
            poam_id = int(snow_poam["poam_id"].item())
        except ValueError:
            unstable_logger.warning("'csam_id' or 'poam_id' is missing/invalid for SNOW CSAM POAM entry for %s. POAM Sys Id: %s", wt_number, poam_id['value'])
            continue

        try:
            poam = csam_retry(system_poam_api.v1_systems_system_id_poams_poam_id_get)(csam_id, poam_id)
        except KeyError:
            unstable_logger.warning(
                "POAM %s not found in CSAM host %s",
                poam_id,
                csam_api.configuration.host,
                extra=log_ctx,
            )
            continue
        except csam_api_client.exceptions.ForbiddenException as e:
            unstable_logger.warning(
                "Got %s when querying %s-%s CSAM host %s",
                str(e),
                csam_id, 
                poam_id,
                csam_api.configuration.host,
                extra=log_ctx,
            )
            continue


        if poam is None:
            unstable_logger.warning(
                "POAM %s not found in CSAM host %s",
                poam_id,
                csam_api.configuration.host,
                extra=log_ctx,
            )
            continue

        if not created_by_rise(csam_api, poam.system_id, poam.poam_id):
            logger.warning("%s not created by RISE Automation, skipping. ISSO must follow up on closure.", poam.poam_id)
            continue

        findings = get_n_transform_snow(SNOW_FINDINGS_TABLE_NAME, offset_limit=500, limit=int(total_findings)+100, fields=[], sysparm_query=f"weakness_tracking={wt_sys_id}")

        if not findings.select(pl.col('state').eq('mitigated'))['state'].all():
            logger.warning("%s Findings are not all mitigated...skipping", wt_number)
            continue

        
        if poam.status not in closed_statuses:
            logger.debug("Prepparing %s POAM %s for closure", wt_number, poam_id)
            wtp = WeaknessTrackerPoam(wt_sys_id)
            wtp.poam = poam
            wtp.number = wt_number
            to_close.append(wtp)
            poam_findings[poam_id] = findings
        
    logger.info("%s POAMs will be closed", len(to_close))

    if to_close:
        draft_poam_updates = []
        for wtp in to_close:
            update = csam_api_client.PoamUpdate(**wtp.poam.to_dict())
            update.actual_finish_date = today
            if update.actual_start_date == update.actual_finish_date:
                update.actual_start_date = update.actual_start_date - datetime.timedelta(days=1)
            draft_poam_updates.append(update)
        updated_poams, failed_updated_poams = submit_to_csam(put_poam_update, csam_api, draft_poam_updates)
        log_failed(to_close, failed_updated_poams)

        logger.debug("Getting Milestone information from POAMs to close")
        milestones_api = csam_api_client.PoamMilestonesApi(csam_api)
        milestones = get_poam_level_api_call(milestones_api.v1_systems_system_id_poams_poam_id_milestones_get, [(wtp.poam.system_id, wtp.poam.poam_id) for wtp in to_close])
        draft_update_milestones = [(*x, ms.action_number, csam_api_client.PoamMilestoneUpdate(**ms.to_dict())) for x, mss in milestones.items() for ms in mss]
        for draft in draft_update_milestones:
            for date in ['actual_start_date', 'actual_finish_date']:
                if not getattr(draft[-1], date):
                    setattr(draft[-1], date, today)

        wtp_milestones = [wtp for wtp, mss in zip(to_close, milestones) for ms in mss]
        logger.debug("Updating Milestones Actual Finish Date to today: %s", today)
        updated_milestones, failed_updated_milestones = submit_to_csam(put_draft_poam_milestone, csam_api, draft_update_milestones)
        log_failed(wtp_milestones, failed_updated_milestones)

        # need to attach mitigated findings
        findings_cols = ['plugin', 'plugin_name', 'ip_address', 'netbios_name', 'dns_name', 'first_discovered', 'last_observed', 'state']
        draft_mit_findings_artifacts = [(wtp.poam.system_id, get_system_acronym(wtp.poam.system_id), wtp.poam.poam_id, poam_findings[wtp.poam.poam_id][findings_cols]) for wtp in to_close]
        _, failed_mit_artifacts = submit_to_csam(post_poam_findings_mitigated_list, csam_api, draft_mit_findings_artifacts)
        log_failed(to_close, failed_mit_artifacts)

        # after attachments, move poam to closed.
        draft_workflow = [[wtp.poam.system_id, wtp.poam.poam_id] for wtp in to_close]
        for workflow_request in CLOSURE_WORFLOW:
            drafts = [dw+[workflow_request] for dw in draft_workflow]
            posted_workflow, failed_workflow = submit_to_csam(post_poam_workflow, csam_api, drafts)
            log_failed(to_close, failed_workflow)
        # update csam poam data table with poam state?

    set_unstable(unstable_logger, unstable_fn_path)

def main() -> None:
    run_id = get_run_id()
    logger.info("Starting POAM Closure", extra={"run_id": run_id})
    try:
        _run(run_id)
        logger.info("POAM Closure Complete", extra={"run_id": run_id})
    except Exception:
        logger.exception("CRITCIAL ERROR: ")
        raise

if __name__ == "__main__":
    main()
