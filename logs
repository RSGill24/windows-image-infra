def purge_test_poams():
    ### removes all POAMs generated by this script (i.e. any POAM with the value assigned to TEST_POAM_DELIM in POAM Title)
    ### purge todo: remove
    if IS_MAIN_BRANCH:
        return
    api = csam_api_client.ApiClient(CSAM_CONFIG)
    system_poam_api = csam_api_client.PoamDetailsApi(api)
    systems_api = csam_api_client.SystemsApi(api)
    systems = systems_api.v1_systems_get(_request_timeout=300)
    systems_ids = [x.id for x in systems] #list of csam system ids
    poams_by_system_id = get_system_level_api_call(system_poam_api.v1_systems_system_id_poams_get, systems_ids, _request_timeout=300)
    poam_status = csam_api_client.PoamStatus
    all_poams = [poam for poams in poams_by_system_id.values() for poam in poams]
    already_created = [p for p in all_poams if TEST_POAM_DELIM in p.title]
    if already_created:
        logger.info("Purging CSAM")
        with RLThreadPoolExecutor(rate_limit=CSAM_RATE_LIMIT) as executor:
            threads = [executor.submit(csam_retry(system_poam_api.v1_systems_system_id_poams_poam_id_delete_with_http_info), p.system_id, p.poam_id) for p in already_created]
        poams_by_system_id = get_system_level_api_call(system_poam_api.v1_systems_system_id_poams_get, systems_ids, _request_timeout=300)#, exclude=[6559])
        all_poams = [poam for poams in poams_by_system_id.values() for poam in poams]

    if "iceserviceportal." not in SNOW_API:
        logger.info('Purging SNow CSAM table')
        snow_poams = get_latest_snow_table(SNOW_POAM_TABLE_NAME, SNOW_API, offset_limit=5000)
        to_delete = snow_poams.filter(pl.col("poam_title").str.contains(TEST_POAM_DELIM.replace("$", "\\$")))[['sys_id']].with_columns(pl.lit("DELETE").alias('HTTP Action'))
        send_to_snow(to_delete, SNOW_POAM_TABLE_NAME)

                    # purging canned milestone generated
        _name = SNOW_MILESTONE_TABLE_NAME
        tmp_file, offset_limit, fields, sysparm_query = SNOW_QUERIES[_name]
        snow_ms = get_n_transform_snow(_name, offset_limit=offset_limit, fields=fields, sysparm_query=sysparm_query)
        to_delete = (
            snow_ms
            .filter(pl.col('sys_created_by').str.contains("VAFT") & pl.col('description').str.contains('<p>'))
            .select(pl.col('sys_id'), pl.lit("DELETE").alias("HTTP Action"))
        )
        send_to_snow(to_delete, SNOW_MILESTONE_TABLE_NAME)


