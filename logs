import logging
import re
from typing import Iterable, List, Sequence, Tuple

from pyspark.sql import DataFrame as SparkDataFrame, Window
from pyspark.sql import functions as F, types as T

logger = logging.getLogger()
logger.setLevel(logging.INFO)

class SparkDfDataQualityUtilities:
    
    def select_fields(self, df: SparkDataFrame, cols: Sequence[str]) -> SparkDataFrame:
        """
        Select a subset of columns from a Spark DataFrame.

        Args:
            df : pyspark.sql.DataFrame
            cols : Sequence[str]: Column names to keep.

        Returns: 
            pyspark.sql.DataFrame
                DataFrame with only the selected columns, in the order provided.
        """
        if not isinstance(df, SparkDataFrame):
            logger.error(
                "select_fields_spark expected a Spark DataFrame, "
                f"got {type(df).__name__!r} instead."
            )
            raise 

        cols = list(cols)  

        if not cols:
            logger.error("select_fields_spark called with an empty list of columns.")
            raise ValueError("cols cannot be empty.")

        df_cols = set(df.columns)
        missing = set(cols) - df_cols
        if missing:
            logger.error(f"Missing columns in DataFrame: {missing}")
            raise KeyError(f"Required columns missing from DataFrame: {missing}")

        return df.select(*cols)
   
    def clean_timestamp_fields(self, df: SparkDataFrame, cols: list[str]) -> SparkDataFrame:
        """
        Clean and convert timestamp columns to TimestampType.
        """
        logger.info("Applying DQ6: Cleaning and converting to timestamp (PySpark)")

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        for col in cols:
            df = df.withColumn(
                col,
                F.to_timestamp(F.trim(F.col(col)))  
            )

        return df
    
    def clean_int_fields(self, df: SparkDataFrame, cols: list[str]) -> SparkDataFrame:
        """
        Clean numeric columns to nullable Integer (BIGINT) in PySpark.
        
        Parameters:
            df (DataFrame): Input PySpark dataframe
            cols (list[str]): List of integer columns
            
        Rules:
            - Convert valid values to 64-bit integer (BIGINT)
            - Replace invalid or missing values with null
            
        Returns:
            DataFrame: Cleaned dataframe
        """
        logger.info("Applying DQ4: Converting numeric(int) columns to Integer (BIGINT) dtype in PySpark")

        # Column existence check
        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        for col in cols:
            # Trim whitespace, then cast to BIGINT.
            # Any invalid value (non-numeric, empty string, etc.) will become null.
            df = df.withColumn(
                col,
                F.trim(F.col(col)).cast("bigint")
            )

        return df
    
    def clean_float_fields(self, df: SparkDataFrame, cols: list[str]) -> SparkDataFrame:
        """
        Clean numeric columns to FloatType in Spark DataFrame

        Parameters:
            df (DataFrame): Input Spark DataFrame
            cols (list[str]): List of float columns

        Rules:
            Convert valid values to Float
            Replace invalid or missing values with null

        Returns:
            DataFrame: Cleaned DataFrame
        """
        logger.info("Applying DQ9: Converting numeric(decimal) columns to FloatType")

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        for col_name in cols:
            # Convert column to float, invalid values become null
            df = df.withColumn(col_name, F.col(col_name).cast(T.FloatType()))

        return df

    def normalize_boolean_fields(self, df: SparkDataFrame, cols: list[str]) -> SparkDataFrame:
        """
        Normalize boolean columns and make dtype BooleanType

        Parameters:
            df (DataFrame): Input Spark DataFrame
            cols (list[str]): List of boolean columns

        Rules:
            Convert valid values to True/False, make dtype BooleanType
            Replace invalid or missing values with null

        Returns:
            DataFrame: Cleaned DataFrame
        """
        logger.info("Applying DQ3: Normalizing boolean columns")

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        for col_name in cols:
            # Normalize values to True/False, invalid/missing become null
            df = df.withColumn(
                col_name,
                F.when(
                    F.lower(F.trim(F.col(col_name))) == "true", True
                ).when(
                    F.lower(F.trim(F.col(col_name))) == "false", False
                ).otherwise(None).cast(T.BooleanType())
            )

        return df

    def apply_not_nullable_q_constraint(self, df: SparkDataFrame, cols: list[str]) -> Tuple[SparkDataFrame, SparkDataFrame]:
        """
        Enforce not-null constraint on the given columns in a PySpark DataFrame.

        Parameters:
            df (DataFrame): Input PySpark dataframe
            cols (list[str]): List of not-nullable columns

        Rules:
            - Rows with null values in any of the given columns are removed 
            from the cleaned df and sent to quarantine_df.
            - quarantine_df contains an 'errors' column describing which 
            columns were null for that row.

        Returns:
            Tuple[DataFrame, DataFrame]: (cleaned_df, quarantine_df)
        """
        logger.info("Applying DQ1: Enforcing Not Nullable constraint (PySpark)")

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        # Condition: any of the cols is null
        any_null_cond = reduce(
            lambda a, b: a | b,
            [F.col(c).isNull() for c in cols]
        )

        def null_values_error_msg(*values):
            null_columns = [col_name for col_name, v in zip(cols, values) if v is None]
            if not null_columns:
                return None
            return "null values in " + ", ".join(null_columns)

        errors_udf = F.udf(null_values_error_msg, T.StringType())

        # Quarantine rows: any null in the specified cols
        quarantine_df = (
            df
            .filter(any_null_cond)
            .withColumn("errors", errors_udf(*[F.col(c) for c in cols]))
        )

        # Cleaned rows: all specified cols are non-null
        all_not_null_cond = reduce(
            lambda a, b: a & b,
            [F.col(c).isNotNull() for c in cols]
        )
        cleaned_df = df.filter(all_not_null_cond)

        return cleaned_df, quarantine_df
    
    def apply_no_duplicates_constraint(self, df: SparkDataFrame, cols: list[str]) -> Tuple[SparkDataFrame, SparkDataFrame]:
        """
        Enforce no duplicates constraint on the given columns in Spark DataFrame

        Parameters:
            df (DataFrame): Input Spark DataFrame
            cols (list[str]): List of columns to check for duplicates

        Rules:
            Records with duplicate values in these columns will be removed from df and sent to quarantine_df

        Returns:
            Tuple[DataFrame, DataFrame]: (cleaned_df, quarantine_df)
        """
        logger.info("Applying DQ0: Enforcing no duplicates constraint")

        missing = set(cols) - set(df.columns)
        if missing:
            logger.error(f"Missing columns: {missing}")
            raise KeyError(f"Required columns missing: {missing}")

        # Find duplicate rows based on the subset columns
        window_cols = cols
        dup_counts = df.groupBy(window_cols).count()
        dup_rows = dup_counts.filter(F.col("count") > 1).select(*window_cols)

        # Quarantine DataFrame: rows that are duplicates in any of the specified columns
        quarantine_df = df.join(dup_rows, on=window_cols, how="inner")

        # Cleaned DataFrame: rows that are not duplicates in the specified columns
        cleaned_df = df.join(dup_rows, on=window_cols, how="left_anti")

        # Add 'errors' column to quarantine_df
        quarantine_df = quarantine_df.withColumn(
            "errors",
            F.lit("duplicates in " + ", ".join(cols))
        )

        return cleaned_df, quarantine_df
    
    def dedup_by_composite_key_with_timestamp(self,  df: SparkDataFrame,  cols: List[str],  if_dups_col: str,) -> Tuple[SparkDataFrame, SparkDataFrame]:
        """
        Deduplicate records in a Spark DataFrame based on a composite primary key and
        a timestamp column.

        Rules:
        For each group of rows sharing the same values in `cols`:
        - The row with the maximum `if_dups_col` value is kept in `clean_df`.
        - All other rows in the group are placed in `quarantine_df`.

        Records that have unique primary key combinations (no duplicates) are all
        included in `clean_df`.

        Parameters
        ----------
        input_df : pyspark.sql.DataFrame
            The input Spark DataFrame containing the records to be deduplicated.
        cols : list[str]
            List of column names that together define the primary key (e.g., ['col1', 'col2']).
        if_dups_col : str
            Name of the timestamp (or time-like) column used to determine the most recent
            record when duplicates exist for a given primary key.

        Returns
        -------
        clean_df : pyspark.sql.DataFrame
            DataFrame containing the deduplicated records (most recent per primary key).
        quarantine_df : pyspark.sql.DataFrame
            DataFrame containing all duplicate records that were not selected as the most recent.

        """

        logger.info(f"Starting PK-based deduplication with timestamp. PK cols {cols}, if dup timestamp col: {if_dups_col}")

        if not cols:
            raise ValueError("Parameter `cols` (primary key columns) must be a non-empty list.")

        if len(cols) != len(set(cols)):
            raise ValueError(f"Duplicate column names found in primary key list: {cols}")

        required_cols = set(cols) | {if_dups_col}
        missing = required_cols - set(df.columns)
        if missing:
            logger.error(f"Missing required columns: {missing}", )
            raise KeyError(f"Required columns missing from input_df: {missing}")

        # Window specification: partition by PK, order by timestamp (most recent first)
        # Use desc_nulls_last so non-null timestamps are preferred over nulls.
        w = Window.partitionBy(*[F.col(c) for c in cols]).orderBy(
            F.col(if_dups_col).desc_nulls_last()
        )

        # Avoid clashing with an existing column name
        aux_col = "__dq_row_number"
        if aux_col in df.columns:
            raise ValueError(
                f"Auxiliary column name '{aux_col}' already exists in the input_df. "
                "Please rename it or adjust the function to use a different internal column name."
            )
        # Assign a row number within each PK group
        df_with_rank = df.withColumn(aux_col, F.row_number().over(w))

        # Clean records: the most recent (row_number == 1) within each PK group        
        clean_df = df_with_rank.filter(F.col(aux_col) == 1).drop(aux_col)

        # Quarantine records: other rows in the group (row_number > 1)
        quarantine_df = df_with_rank.filter(F.col(aux_col) > 1).drop(aux_col)

        return clean_df, quarantine_df
    
    def parse_framework_values(
            self,
            spark_df: SparkDataFrame, 
            reference_col: str, 
            frameworks: List[str]
        ) -> SparkDataFrame:
        """
        Extracts control values for specified frameworks from a column containing arrays of structs,
        and adds them as new columns to the Spark DataFrame.

        Args:
            spark_df (pyspark.sql.DataFrame): Input Spark DataFrame.
            reference_col (str): Name of the column containing array of structs.
            frameworks (list): List of framework values to extract.

        Returns:
            pyspark.sql.DataFrame: DataFrame with new columns for each framework.

        Raises:
            ValueError: If column_name does not exist in spark_df.
        """
        if reference_col not in spark_df.columns:
            raise ValueError(f"Column '{reference_col}' does not exist in the DataFrame.")

        def snake_case(s):
            return re.sub(r'[^a-zA-Z0-9]', '_', s).lower()

        df = spark_df
        for fw in frameworks:
            col_name = snake_case(fw)
            # Use filter and get control value for the matching framework
            df = df.withColumn(
                col_name,
                F.expr(
                    f"""
                    filter({reference_col}, x -> x.framework = '{fw}')
                    """
                )[0].control
            )
        return df
    
    def normalize_for_postgres_jdbc(self, df: SparkDataFrame) -> SparkDataFrame:
        """
        Make a Spark DataFrame JDBC-friendly for PostgreSQL:
        - StructType                -> JSON string
        - ArrayType(StructType)     -> ArrayType(StringType) using JSON per element
        - Primitive arrays          -> left as ArrayType (for text[] / int[] etc.)
        - Other primitive types     -> unchanged
        """
        result = df
        for field in df.schema.fields:
            name = field.name
            dtype = field.dataType

            # Top-level struct -> JSON
            if isinstance(dtype, T.StructType):
                result = result.withColumn(name, F.to_json(F.col(name)))

            # Array of struct -> array<string> (each element JSON)
            elif isinstance(dtype, T.ArrayType) and isinstance(dtype.elementType, T.StructType):
                result = result.withColumn(
                    name,
                    F.transform(F.col(name), lambda x: F.to_json(x))
                )

        return result
    
    def convert_array_fields_to_json(self, df: SparkDataFrame) -> SparkDataFrame:
        """
        Convert columns containing array-like data (Spark ArrayType) to JSON strings.
        Notes
        -----
         In Spark, Python lists / NumPy arrays in the input are represented as `ArrayType` 
         columns in the DataFrame schema.  
        
        Args:   
        df : pyspark.sql.DataFrame. Input dataframe

        Returns:
        pyspark.sql.DataFrame
            DataFrame where all ArrayType columns are converted to JSON strings.
        """
        if not isinstance(df, SparkDataFrame):
            raise TypeError(
                f"convert_array_like_cols_to_json expected a Spark DataFrame, "
                f"got {type(df).__name__!r} instead."
            )

        array_cols: Iterable[str] = [
            field.name
            for field in df.schema.fields
            if isinstance(field.dataType, T.ArrayType)
        ]

        if array_cols:
            logger.info(f"Converting ArrayType columns to JSON strings: {array_cols}")      
            for col_name in array_cols:
                df = df.withColumn(col_name, F.to_json(F.col(col_name)))

        return df
    
