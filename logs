    def refresh_materialized_views(
        self,
        engine: Engine,
        views: list        
    )-> None:
        """
        Refreshes materialized views

        Parameters:
            engine (Engine): Database engine for data access.
            views (list): list of the views
        """

        for view in views:
            logger.info(f"Refreshing materialized view: {view}")
            sql = f"REFRESH MATERIALIZED VIEW {MAIN_SCHEMA}.{view}"
            rw_util.execute_ddl_dml(
                engine=engine,
                sql=sql
            )

        ##Parallel loading##
        logger.info("Refresh view in 'crmahivedb_fqt' on 'eda-crmahive-np' ")
        engine2 = connection.postgres_engine("edae-crma-hive", "crmahivedb_fqt")
        for view in views:
            logger.info(f"Refreshing materialized view: {view}")
            sql = f"REFRESH MATERIALIZED VIEW {MAIN_SCHEMA}.{view}"
            rw_util.execute_ddl_dml(
                engine=engine2,
                sql=sql
            )
