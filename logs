    # be added to the WT
    if completed_wtps:
        poam_table_update = (
            pl.from_dicts([wtp.poam.to_dict() for wtp in completed_wtps])
            .rename(poam_table_report_mapping)
            .with_columns(pl.lit('POST').alias('HTTP Action'))
        )
        send_to_snow(poam_table_update, table_name=SNOW_POAM_TABLE_NAME)

        # add poam id to the WT for the CSAM POAM Table reference
        wtp_df = pl.from_dicts({"number":wtp.number, "poa_m_id":wtp.poam.poam_id} for wtp in completed_wtps)
        to_update_wtp = (
            wtp_df
            .join(latest_weakness_trackers, on="number")
            .drop('poa_m_id_right')
            .with_columns(pl.lit("PATCH").alias('HTTP Action'))
        )
        send_to_snow(to_update_wtp, table_name=SNOW_WEAKNESS_TRACKING_TABLE_NAME)  


    poams_generated = len(completed_wtps)
    milestones_generated = sum([len(wtp.draft_milestones) for wtp in completed_wtps if (wtp.poam.system_id, wtp.poam.poam_id) not in failed])
    logger.info("Automated POAMs complete. Generated %s POAMs and %s Milestones", poams_generated, milestones_generated)

    if failed:
        unstable_logger.warning(f"Encountered errors that affected {len(failed)} WTs. Refer to logged failures.")

    set_unstable(unstable_logger, unstable_fn_path)
        

    
