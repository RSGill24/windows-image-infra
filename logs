    def test_apply_not_nullable_q_constraint_correclty_splits_records_into_separate_dataframes(self):
        '''
        Test apply_no_not_nullable_q_constraint correclty splits records into seperate dataframes

        cleaned:
        --------------------------------
        |A_key      |B_key      |C     |
        --------------------------------
        |1          |"a"        |11    |
        |5          |"e"        |55    |
        

        quartinined:
        --------------------------------
        |A_key      |B_key      |C     |
        --------------------------------
        |None       |"b"        |22    |
        |3          |None       |33    |
        |None       |"d"        |44    |
        '''

        not_nullable_constraint = pd.DataFrame({
            "A_key": [ 1, None, 3, None,5],
            "B_key": [ "a", "b", None, "d", "e"],
            "C":[11, 22, 33, 44, 55 ]
        })
        cleaned_df, quarantine_df  = self.dq.apply_not_nullable_q_constraint(not_nullable_constraint, ["A_key", "B_key"])
        expected_cleaned_df = pd.DataFrame({"A_key": [ 1.0,5.0], "B_key":["a","e"], "C":[11,55]})
        expected_quarantine_df = pd.DataFrame({"A_key": [ None,3,None], "B_key":["b",None,"d"], "C":[22,33,44], 
        "errors":["null values in A_key","null values in B_key","null values in A_key"]})
        pdt.assert_frame_equal(expected_cleaned_df.reset_index(drop=True), cleaned_df.reset_index(drop=True))
        pdt.assert_frame_equal(expected_quarantine_df.reset_index(drop=True), quarantine_df.reset_index(drop=True))

    def test_apply_not_nullable_w_constraint_correclty_splits_records_into_separate_dataframes(self):
        '''
        Test apply_no_not_nullable_w_constraint correclty splits records into seperate dataframes

        input:
        --------------------------------
        |A_key      |B_key      |C     |
        --------------------------------
        |1          |"a"        |11    |
        |2          |"b"        |None  |
        |3          |"c"        |None  |
        |4          |"d"        |None  |
        |5          |"e"        |55    |
        

        warning:
        --------------------------------
        |A_key      |B_key      |C     |
        --------------------------------
        |2          |"b"        |None    |
        |3          |"c"        |None    |
        |4          |"d"        |None    |
        '''
        not_nullable_constraint = pd.DataFrame({
            "A_key": [ 1, 2, 3, 4, 5],
            "B_key": [ "a", "b", "c", "d", "e"],
            "C":[11, None, None, None, 55 ]
        })
        warning_df  = self.dq.apply_not_nullable_w_constraint(not_nullable_constraint, ["C"])
        expected_warning_df = pd.DataFrame({"A_key": [ 2,3,4], "B_key":["b","c","d"], "C":[np.nan,np.nan,np.nan], 
        "warnings":["null values in C","null values in C","null values in C"]})
        pdt.assert_frame_equal(expected_warning_df.reset_index(drop=True), warning_df.reset_index(drop=True))

    def test_apply_no_duplicate_constraint_correclty_splits_records_into_separate_dataframes(self):
        '''
        Test apply_no_duplicate_constraint correclty splits records into seperate dataframes

        cleaned:
        --------------------------------
        |A_key      |B_key      |C     |
        --------------------------------
        |1          |"a"        |11    |
        |2          |"b"        |22    |
        |5          |"e"        |55    |

        quartinined:
        --------------------------------
        |A_key      |B_key      |C     |
        --------------------------------
        |3          |None       |33    |
        |3          |"d"        |44    |
        '''
        no_duplicates_constraint = pd.DataFrame({
            "A_key": [ 1, 2, 3, 3,5],
            "B_key": [ "a", "b", "c", "d", "e"],
            "C":[11, 22, 33, 44, 55 ]
        })
        cleaned_df, quarantine_df  = self.dq.apply_no_duplicates_constraint(no_duplicates_constraint, ["A_key"])
        expected_cleaned_df = pd.DataFrame({"A_key": [1,2,5], "B_key":["a","b","e"], "C":[11,22,55]})
        expected_quarantine_df = pd.DataFrame({"A_key": [3,3], "B_key":["c","d"], "C":[33,44], 
        "errors":["duplicates in A_key","duplicates in A_key"]})
        pdt.assert_frame_equal(expected_cleaned_df.reset_index(drop=True), cleaned_df.reset_index(drop=True))
        pdt.assert_frame_equal(expected_quarantine_df.reset_index(drop=True), quarantine_df.reset_index(drop=True))
        
