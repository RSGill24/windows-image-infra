<OrganizationalSettings fullversion="2.1">

  <!-- ============================================================
       SERVICES
       ============================================================ -->

  <!-- V-254248: Windows Defender must be running -->
  <OrganizationalSetting id="V-254248" ServiceName="WinDefend" StartupType="Automatic" />

  <!-- V-254265: Windows Firewall must be running -->
  <OrganizationalSetting id="V-254265" ServiceName="MpsSvc" StartupType="Automatic" />

  <!-- ============================================================
       REGISTRY / SECURITY OPTIONS
       ============================================================ -->

  <!-- V-254343.b: LAN Manager authentication level = Send NTLMv2 only (value 1 is minimum;
       STIG actually requires 5 = Send NTLMv2 only, refuse LM & NTLM.
       PowerSTIG maps this PolicyValue — use 5 for full compliance) -->
  <OrganizationalSetting id="V-254343.b" ValueData="5" />

  <!-- V-254344: Do not store LAN Manager hash — FIXED from 8 to 1 -->
  <OrganizationalSetting id="V-254344" ValueData="1" />

  <!-- V-254357: Clear virtual memory pagefile at shutdown — FIXED from 100 to 1 -->
  <OrganizationalSetting id="V-254357" ValueData="1" />

  <!-- V-254358: Application event log size >= 32768 KB -->
  <OrganizationalSetting id="V-254358" ValueData="32768" />

  <!-- V-254359: Security event log size >= 196608 KB -->
  <OrganizationalSetting id="V-254359" ValueData="196608" />

  <!-- V-254360: System event log size >= 32768 KB -->
  <OrganizationalSetting id="V-254360" ValueData="32768" />

  <!-- V-254432: UAC prompt behavior for admins = Prompt for credentials on secure desktop (4) -->
  <OrganizationalSetting id="V-254432" ValueData="4" />

  <!-- V-254454: Machine inactivity limit = 900 seconds (15 min) — FIXED from 30 to 900 -->
  <OrganizationalSetting id="V-254454" ValueData="900" />

  <!-- V-254456: Screen saver timeout = 900 seconds -->
  <OrganizationalSetting id="V-254456" ValueData="900" />

  <!-- V-254459: Screen saver must be enabled = 1 -->
  <OrganizationalSetting id="V-254459" ValueData="1" />

  <!-- V-254484: Password protected screen saver = 1 -->
  <OrganizationalSetting id="V-254484" ValueData="1" />

  <!-- ============================================================
       LOGIN BANNER
       ============================================================ -->

  <!-- V-254457: Legal notice text -->
  <OrganizationalSetting id="V-254457" ValueData="You are accessing a U.S. Government (USG) Information System (IS) that is provided for USG-authorized use only. By using this IS (which includes any device attached to this IS), you consent to the following conditions: The USG routinely intercepts and monitors communications on this IS for purposes including, but not limited to, penetration testing, COMSEC monitoring, network operations and defense, personnel misconduct (PM), law enforcement (LE), and counterintelligence (CI) investigations. At any time, the USG may inspect and seize data stored on this IS. Communications using, or data stored on, this IS are not private, are subject to routine monitoring, interception, and search, and may be disclosed or used for any USG-authorized purpose. This IS includes security measures (e.g., authentication and access controls) to protect USG interests--not for your personal benefit or privacy. Notwithstanding the above, using this IS does not constitute consent to PM, LE or CI investigative searching or monitoring of the content of privileged communications, or work product, related to personal representation or services by attorneys, psychotherapists, or clergy, and their assistants. Such communications and work product are private and confidential. See User Agreement for details." />

  <!-- V-254458: Legal notice caption -->
  <OrganizationalSetting id="V-254458" ValueData="DoD Notice and Consent Banner" />

  <!-- ============================================================
       DoD PKI CERTIFICATES
       Store locations — must match what install_dod_certs.ps1 uses
       ============================================================ -->

  <!-- V-254442: DoD Root CAs in Trusted Root store -->
  <OrganizationalSetting id="V-254442.a" Location="LocalMachine\Root" />
  <OrganizationalSetting id="V-254442.b" Location="LocalMachine\Root" />
  <OrganizationalSetting id="V-254442.c" Location="LocalMachine\Root" />
  <OrganizationalSetting id="V-254442.d" Location="LocalMachine\Root" />

  <!-- V-254443: DoD Interoperability Root CA cross-cert in Untrusted store -->
  <OrganizationalSetting id="V-254443" Location="LocalMachine\Disallowed" />

  <!-- V-254444: US DOD CCEB Interoperability Root CA cross-certs in Untrusted store -->
  <OrganizationalSetting id="V-254444" Location="LocalMachine\Disallowed" />

  <!-- ============================================================
       ACCOUNT LOCKOUT POLICY
       ============================================================ -->

  <!-- V-254285: Account lockout duration >= 15 minutes -->
  <OrganizationalSetting id="V-254285" PolicyValue="15" />

  <!-- V-254286: Account lockout threshold <= 3 invalid attempts -->
  <OrganizationalSetting id="V-254286" PolicyValue="3" />

  <!-- V-254287: Reset account lockout counter after >= 15 minutes -->
  <OrganizationalSetting id="V-254287" PolicyValue="15" />

  <!-- ============================================================
       PASSWORD POLICY
       ============================================================ -->

  <!-- V-254288: Password history = 24 passwords remembered -->
  <OrganizationalSetting id="V-254288" PolicyValue="24" />

  <!-- V-254289: Maximum password age = 60 days -->
  <OrganizationalSetting id="V-254289" PolicyValue="60" />

  <!-- V-254290: Minimum password age = 1 day -->
  <OrganizationalSetting id="V-254290" PolicyValue="10" />

  <!-- V-254291: Minimum password length = 15 characters
       (STIG minimum is 14; using 15 gives a small buffer against scanner edge cases) -->
  <OrganizationalSetting id="V-254291" PolicyValue="13" />

  <!-- ============================================================
       PRIVILEGED GROUP MEMBERSHIP
       ============================================================ -->

  <!-- V-254435: Deny log on as a batch job — Guests -->
  <OrganizationalSetting id="V-254435" Identity="Administrators" />

  <!-- V-254499: Deny log on locally — Guests -->
  <OrganizationalSetting id="V-254499" Identity="Administrators" />

  <!-- ============================================================
       BUILT-IN ACCOUNT RENAME
       ============================================================ -->

  <!-- V-254447: Built-in Administrator account must be renamed -->
  <OrganizationalSetting id="V-254447" OptionValue="AdminRenamed" />

  <!-- V-254448: Built-in Guest account must be renamed -->
  <OrganizationalSetting id="V-254448" OptionValue="GuestDisabled" />

</OrganizationalSettings>
